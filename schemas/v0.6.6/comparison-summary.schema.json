  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.6/comparison-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.2.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "baseline_usage_summary"
              ]
            },
            {
              "required": [
                "candidate_usage_summary"
              ]
            },
            {
              "required": [
                "usage_delta"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.6.3",
