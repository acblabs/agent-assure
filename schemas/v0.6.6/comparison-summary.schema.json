{
  "$defs": {
    "ComparisonClassification": {
      "enum": [
        "new_failure",
        "resolved_failure",
        "persistent_failure",
        "unchanged",
        "allowed_behavioral_change",
        "allowed_behavioral_and_provenance_change",
        "provenance_only_change",
        "invalid_comparison",
        "not_evaluated"
      ],
      "title": "ComparisonClassification",
      "type": "string"
    },
    "EnvironmentInfo": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "environment-info",
          "default": "environment-info",
          "title": "Artifact Kind",
          "type": "string"
        },
        "dependency_inventory_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Inventory Digest"
        },
        "dependency_inventory_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Inventory Path"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "git_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Dirty"
        },
        "installed_packages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InstalledPackage"
          },
          "title": "Installed Packages",
          "type": "array"
        },
        "lockfile_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lockfile Digest"
        },
        "lockfile_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lockfile Path"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "const": "0.6.6",
          "default": "0.6.6",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "python_version",
        "artifact_kind",
        "schema_version"
      ],
      "title": "EnvironmentInfo",
      "type": "object"
    },
    "GateState": {
      "enum": [
        "pass",
        "fail",
        "warn",
        "not_evaluated"
      ],
      "title": "GateState",
      "type": "string"
    },
    "InstalledPackage": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "installed-package",
          "default": "installed-package",
          "title": "Artifact Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "0.6.6",
          "default": "0.6.6",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "artifact_kind",
        "schema_version"
      ],
      "title": "InstalledPackage",
      "type": "object"
    },
    "UsageMetricCoverage": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost_microusd": {
          "default": 0,
          "minimum": 0,
          "title": "Estimated Cost Microusd",
          "type": "integer"
        },
        "total_latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Total Latency Ms",
          "type": "integer"
        },
        "total_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Total Retries",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "total_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageMetricCoverage",
      "type": "object"
    },
    "UsageSummary": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.3.1"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cost_basis_ids"
                  ]
                },
                {
                  "required": [
                    "pricing_snapshot_ids"
                  ]
                },
                {
                  "required": [
                    "pricing_snapshot_digests"
                  ]
                },
                {
                  "required": [
                    "cost_observation_count"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.3.1",
                  "0.4.3"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "aggregation_method"
                  ]
                },
                {
                  "required": [
                    "coverage_basis"
                  ]
                },
                {
                  "required": [
                    "source_count"
                  ]
                },
                {
                  "required": [
                    "coverage_counts"
                  ]
                },
                {
                  "required": [
                    "estimated_cost_picousd"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.6.6"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "aggregation_method": {
                "const": "sum_complete_fields_v2"
              }
            },
            "required": [
              "aggregation_method",
              "coverage_basis",
              "source_count",
              "coverage_counts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "estimated_cost_microusd": {
                "type": "integer"
              },
              "schema_version": {
                "const": "0.6.6"
              }
            },
            "required": [
              "schema_version",
              "estimated_cost_microusd"
            ]
          },
          "then": {
            "required": [
              "estimated_cost_picousd"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "estimated_cost_microusd": {
                "type": "integer"
              }
            },
            "required": [
              "estimated_cost_microusd"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "const": "USD"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "total_tokens": {
                "type": "integer"
              }
            },
            "required": [
              "total_tokens"
            ]
          },
          "then": {
            "properties": {
              "coverage_counts": {
                "properties": {
                  "total_tokens": {
                    "minimum": 1
                  }
                }
              },
              "source_count": {
                "minimum": 1
              }
            },
            "required": [
              "source_count",
              "coverage_counts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "total_tool_calls": {
                "type": "integer"
              }
            },
            "required": [
              "total_tool_calls"
            ]
          },
          "then": {
            "properties": {
              "coverage_counts": {
                "properties": {
                  "total_tool_calls": {
                    "minimum": 1
                  }
                }
              },
              "source_count": {
                "minimum": 1
              }
            },
            "required": [
              "source_count",
              "coverage_counts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "total_retries": {
                "type": "integer"
              }
            },
            "required": [
              "total_retries"
            ]
          },
          "then": {
            "properties": {
              "coverage_counts": {
                "properties": {
                  "total_retries": {
                    "minimum": 1
                  }
                }
              },
              "source_count": {
                "minimum": 1
              }
            },
            "required": [
              "source_count",
              "coverage_counts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "total_latency_ms": {
                "type": "integer"
