              "total_latency_ms"
            ]
          },
          "then": {
            "properties": {
              "coverage_counts": {
                "properties": {
                  "total_latency_ms": {
                    "minimum": 1
                  }
                }
              },
              "source_count": {
                "minimum": 1
              }
            },
            "required": [
              "source_count",
              "coverage_counts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "estimated_cost_microusd": {
                "type": "integer"
              }
            },
            "required": [
              "estimated_cost_microusd"
            ]
          },
          "then": {
            "properties": {
              "coverage_counts": {
                "properties": {
                  "estimated_cost_microusd": {
                    "minimum": 1
                  }
                }
              },
              "source_count": {
                "minimum": 1
              }
            },
            "required": [
              "source_count",
              "coverage_counts"
