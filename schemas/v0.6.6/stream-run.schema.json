          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "title": "StreamSequenceContract",
      "type": "object"
    },
    "UsageLedger": {
      "$comment": "Pydantic validation verifies that missingness equals the counts derived from segments. A current parent ledger also revalidates provider and model identifiers on every nested segment, including legacy-version segments. JSON Schema mirrors that parent-owned identifier boundary while validating shape and non-negative counts.",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "aggregation_method": {
                "const": "sum_complete_fields_v2"
              }
            },
            "required": [
              "aggregation_method"
            ]
          },
          "then": {
            "properties": {
              "schema_version": {
                "const": "0.6.6"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.6.6"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "aggregation_method": {
                "const": "sum_complete_fields_v2"
              }
            },
            "required": [
              "aggregation_method"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "aggregation_method": {
                "const": "sum_known_fields_v1"
              }
            },
            "required": [
              "aggregation_method"
            ]
          },
          "then": {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.3.1",
                  "0.4.3"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "segments": {
                "items": {
                  "properties": {
                    "model": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?:@[A-Za-z0-9][A-Za-z0-9._:/-]{0,254})?(?![\\s\\S])"
                    },
                    "provider": {
                      "maxLength": 256,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                    }
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.3.1",
                  "0.4.3"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          }
        }
      ],
      "properties": {
        "aggregation_method": {
          "default": "sum_complete_fields_v2",
          "enum": [
            "sum_known_fields_v1",
            "sum_complete_fields_v2"
          ],
          "title": "Aggregation Method",
          "type": "string"
        },
        "artifact_kind": {
          "const": "usage-ledger",
          "default": "usage-ledger",
          "title": "Artifact Kind",
          "type": "string"
        },
        "missingness": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Counts of segment fields that were missing during aggregation; Pydantic validation requires this to match the contributing segments.",
          "title": "Missingness",
          "type": "object"
        },
        "schema_version": {
          "const": "0.6.6",
          "default": "0.6.6",
          "title": "Schema Version",
          "type": "string"
        },
        "segments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UsageSegment"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "artifact_kind",
        "schema_version"
      ],
      "title": "UsageLedger",
      "type": "object"
    },
    "UsageMetricCoverage": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost_microusd": {
