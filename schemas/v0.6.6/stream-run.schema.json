    "StreamEventRecord": {
      "$comment": "A current stream-event parent revalidates provider and model identifiers on its usage segment even when that segment declares a legacy schema version.",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.6.6"
              }
            }
          },
          "then": {
            "properties": {
              "usage_segment": {
                "properties": {
                  "model": {
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?:@[A-Za-z0-9][A-Za-z0-9._:/-]{0,254})?(?![\\s\\S])"
                  },
                  "provider": {
                    "maxLength": 256,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_kind": {
          "const": "stream-event-record",
          "default": "stream-event-record",
          "title": "Artifact Kind",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
          "title": "Digest",
          "type": "string"
        },
        "event_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "node_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameworkObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "privacy_filtered_attributes": {
          "additionalProperties": {
            "maxLength": 8192,
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 512
          },
          "title": "Privacy Filtered Attributes",
          "type": "object"
        },
        "producer_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Id"
        },
        "run_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.6.6",
          "default": "0.6.6",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_number": {
          "minimum": 0,
          "title": "Sequence Number",
          "type": "integer"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "traceparent": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        },
        "usage_segment": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageSegment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
