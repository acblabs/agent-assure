          "default": 0,
          "minimum": 0,
          "title": "Estimated Cost Microusd",
          "type": "integer"
        },
        "total_latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Total Latency Ms",
          "type": "integer"
        },
        "total_retries": {
          "default": 0,
          "minimum": 0,
          "title": "Total Retries",
          "type": "integer"
        },
        "total_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tokens",
          "type": "integer"
        },
        "total_tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Total Tool Calls",
          "type": "integer"
        }
      },
      "title": "UsageMetricCoverage",
      "type": "object"
    }
  },
  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.6/usage-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.3.1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "cost_basis_ids"
              ]
            },
            {
              "required": [
                "pricing_snapshot_ids"
              ]
            },
            {
              "required": [
                "pricing_snapshot_digests"
              ]
            },
            {
              "required": [
                "cost_observation_count"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.3.1",
              "0.4.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "aggregation_method"
              ]
            },
            {
              "required": [
                "coverage_basis"
              ]
            },
            {
              "required": [
                "source_count"
              ]
            },
            {
              "required": [
                "coverage_counts"
              ]
            },
            {
              "required": [
                "estimated_cost_picousd"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.6.6"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "aggregation_method": {
            "const": "sum_complete_fields_v2"
          }
        },
        "required": [
          "aggregation_method",
          "coverage_basis",
          "source_count",
          "coverage_counts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "estimated_cost_microusd": {
            "type": "integer"
          },
          "schema_version": {
            "const": "0.6.6"
          }
        },
        "required": [
          "schema_version",
          "estimated_cost_microusd"
        ]
      },
      "then": {
        "required": [
          "estimated_cost_picousd"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "estimated_cost_microusd": {
            "type": "integer"
          }
        },
        "required": [
          "estimated_cost_microusd"
        ]
      },
      "then": {
        "properties": {
          "currency": {
            "const": "USD"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "total_tokens": {
            "type": "integer"
          }
        },
        "required": [
          "total_tokens"
        ]
      },
      "then": {
        "properties": {
          "coverage_counts": {
            "properties": {
              "total_tokens": {
                "minimum": 1
              }
            }
          },
          "source_count": {
            "minimum": 1
          }
        },
        "required": [
          "source_count",
          "coverage_counts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "total_tool_calls": {
            "type": "integer"
          }
        },
        "required": [
          "total_tool_calls"
        ]
      },
      "then": {
        "properties": {
          "coverage_counts": {
            "properties": {
              "total_tool_calls": {
                "minimum": 1
              }
            }
          },
          "source_count": {
            "minimum": 1
          }
        },
        "required": [
          "source_count",
          "coverage_counts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "total_retries": {
            "type": "integer"
          }
        },
        "required": [
          "total_retries"
        ]
      },
      "then": {
        "properties": {
          "coverage_counts": {
            "properties": {
              "total_retries": {
                "minimum": 1
              }
            }
          },
          "source_count": {
            "minimum": 1
          }
        },
        "required": [
          "source_count",
          "coverage_counts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "total_latency_ms": {
            "type": "integer"
          }
        },
        "required": [
          "total_latency_ms"
        ]
      },
      "then": {
        "properties": {
          "coverage_counts": {
            "properties": {
              "total_latency_ms": {
                "minimum": 1
              }
            }
          },
          "source_count": {
            "minimum": 1
          }
        },
        "required": [
          "source_count",
          "coverage_counts"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "estimated_cost_microusd": {
            "type": "integer"
          }
        },
        "required": [
          "estimated_cost_microusd"
        ]
      },
      "then": {
        "properties": {
          "coverage_counts": {
            "properties": {
              "estimated_cost_microusd": {
                "minimum": 1
              }
            }
          },
          "source_count": {
            "minimum": 1
          }
        },
        "required": [
          "source_count",
          "coverage_counts"
        ]
      }
    }
  ],
  "properties": {
    "aggregation_method": {
      "anyOf": [
        {
          "enum": [
            "sum_known_fields_v1",
            "sum_complete_fields_v2"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregation Method"
    },
    "artifact_kind": {
      "const": "usage-summary",
      "default": "usage-summary",
      "title": "Artifact Kind",
      "type": "string"
    },
    "cost_basis_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Cost Basis Ids",
      "type": "array"
    },
    "cost_observation_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Observation Count"
    },
    "coverage_basis": {
      "anyOf": [
        {
          "enum": [
            "usage_segment",
            "usage_summary",
            "run_record"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage Basis"
    },
    "coverage_counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageMetricCoverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "currency": {
      "default": "USD",
      "pattern": "^[A-Z]{3}(?![\\s\\S])",
      "title": "Currency",
      "type": "string"
    },
    "estimated_cost_microusd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Microusd"
    },
    "estimated_cost_picousd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Estimated Cost Picousd"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "pricing_snapshot_digests": {
      "default": [],
      "items": {
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
        "type": "string"
      },
      "title": "Pricing Snapshot Digests",
      "type": "array"
    },
    "pricing_snapshot_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Pricing Snapshot Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "0.6.6",
      "default": "0.6.6",
      "title": "Schema Version",
      "type": "string"
    },
    "source_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Count"
    },
    "total_latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Latency Ms"
    },
    "total_retries": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Retries"
    },
    "total_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Tokens"
    },
    "total_tool_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Tool Calls"
    }
  },
  "required": [
    "artifact_kind",
    "schema_version"
  ],
  "title": "UsageSummary",
  "type": "object"
}
