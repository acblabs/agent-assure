{
  "$comment": "Pydantic validation verifies that missingness equals the counts derived from segments. A current parent ledger also revalidates provider and model identifiers on every nested segment, including legacy-version segments. JSON Schema mirrors that parent-owned identifier boundary while validating shape and non-negative counts.",
  "$defs": {
    "UsageSegment": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.3.1"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "pricing_snapshot_digest"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.3.1",
                  "0.4.3"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "estimated_cost_picousd"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimated_cost_microusd": {
                "type": "integer"
              }
            },
            "required": [
              "estimated_cost_microusd"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "const": "USD"
              },
              "limitations": {
                "minItems": 1
              }
            },
            "required": [
              "limitations"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "model": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?:@[A-Za-z0-9][A-Za-z0-9._:/-]{0,254})?(?![\\s\\S])"
              },
              "provider": {
                "maxLength": 256,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
              }
            }
          },
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.3.1",
                  "0.4.3"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          }
        }
      ],
      "properties": {
        "artifact_kind": {
          "const": "usage-segment",
          "default": "usage-segment",
          "title": "Artifact Kind",
          "type": "string"
        },
        "cached_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Tokens"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Tokens"
        },
        "cost_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Basis"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}(?![\\s\\S])",
          "title": "Currency",
          "type": "string"
        },
        "estimated_cost_microusd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Microusd"
        },
        "estimated_cost_picousd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Picousd"
        },
        "event_range_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Range End"
        },
        "event_range_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Range Start"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "pricing_snapshot_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Snapshot Digest"
        },
        "pricing_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Snapshot Id"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "retry_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry Count"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "schema_version": {
          "const": "0.6.6",
          "default": "0.6.6",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "tool_call_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Count"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "required": [
        "segment_id",
        "artifact_kind",
        "schema_version"
      ],
      "title": "UsageSegment",
      "type": "object"
    }
  },
  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.6/usage-ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "aggregation_method": {
            "const": "sum_complete_fields_v2"
          }
        },
        "required": [
          "aggregation_method"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "0.6.6"
          }
        },
        "required": [
          "schema_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.6.6"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "aggregation_method": {
            "const": "sum_complete_fields_v2"
          }
        },
        "required": [
          "aggregation_method"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "aggregation_method": {
            "const": "sum_known_fields_v1"
          }
        },
        "required": [
          "aggregation_method"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.3.1",
              "0.4.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "segments": {
            "items": {
              "properties": {
                "model": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?:@[A-Za-z0-9][A-Za-z0-9._:/-]{0,254})?(?![\\s\\S])"
                },
                "provider": {
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
                }
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.3.1",
              "0.4.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      }
    }
  ],
  "properties": {
    "aggregation_method": {
      "default": "sum_complete_fields_v2",
      "enum": [
        "sum_known_fields_v1",
        "sum_complete_fields_v2"
      ],
      "title": "Aggregation Method",
      "type": "string"
    },
    "artifact_kind": {
      "const": "usage-ledger",
      "default": "usage-ledger",
      "title": "Artifact Kind",
      "type": "string"
    },
    "missingness": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "description": "Counts of segment fields that were missing during aggregation; Pydantic validation requires this to match the contributing segments.",
      "title": "Missingness",
      "type": "object"
    },
    "schema_version": {
      "const": "0.6.6",
      "default": "0.6.6",
      "title": "Schema Version",
      "type": "string"
    },
    "segments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UsageSegment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "artifact_kind",
    "schema_version"
  ],
  "title": "UsageLedger",
  "type": "object"
}
