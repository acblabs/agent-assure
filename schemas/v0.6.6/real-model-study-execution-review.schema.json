{
  "$defs": {
    "StudyExecutionReviewCondition": {
      "additionalProperties": false,
      "description": "Exact per-condition evidence reviewed against provider-side records.",
      "properties": {
        "baseline_runset_artifact": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^condition-[0-9]{3}\\.baseline\\.source\\.runset\\.json$",
          "title": "Baseline Runset Artifact",
          "type": "string"
        },
        "baseline_runset_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Baseline Runset Id",
          "type": "string"
        },
        "baseline_runset_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Baseline Runset Sha256",
          "type": "string"
        },
        "condition_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Condition Id",
          "type": "string"
        },
        "counterfactual_runset_artifact": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^condition-[0-9]{3}\\.counterfactual\\.source\\.runset\\.json$",
          "title": "Counterfactual Runset Artifact",
          "type": "string"
        },
        "counterfactual_runset_id": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Counterfactual Runset Id",
          "type": "string"
        },
        "counterfactual_runset_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Counterfactual Runset Sha256",
          "type": "string"
        },
        "execution_attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Execution Attempt Id",
          "type": "string"
        },
        "execution_attempt_journal_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Execution Attempt Journal Digest",
          "type": "string"
        },
        "observed_provenance_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observed Provenance Digest",
          "type": "string"
        },
        "provider_response_id_set_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Response Id Set Digest",
          "type": "string"
        },
        "provider_response_records": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Provider Response Records",
          "type": "integer"
        },
        "provider_serving_fingerprint_records": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Provider Serving Fingerprint Records",
          "type": "integer"
        },
        "provider_serving_fingerprint_status": {
          "$ref": "#/$defs/StudyProviderFingerprintReviewStatus"
        }
      },
      "required": [
        "condition_id",
        "execution_attempt_id",
        "execution_attempt_journal_digest",
        "baseline_runset_artifact",
        "baseline_runset_id",
        "baseline_runset_sha256",
        "counterfactual_runset_artifact",
        "counterfactual_runset_id",
        "counterfactual_runset_sha256",
        "observed_provenance_digest",
        "provider_response_id_set_digest",
        "provider_response_records",
        "provider_serving_fingerprint_records",
        "provider_serving_fingerprint_status"
      ],
      "title": "StudyExecutionReviewCondition",
      "type": "object"
    },
    "StudyProviderFingerprintReviewStatus": {
      "enum": [
        "complete_and_stable",
        "not_exposed_by_provider"
      ],
      "title": "StudyProviderFingerprintReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.6/real-model-study-execution-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Independent post-execution review of exact provider-backed evidence.",
  "properties": {
    "artifact_kind": {
      "const": "real-model-study-execution-review",
      "default": "real-model-study-execution-review",
      "title": "Artifact Kind",
      "type": "string"
    },
    "attestation_basis": {
      "const": "human_operator_attestation",
      "default": "human_operator_attestation",
      "title": "Attestation Basis",
      "type": "string"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/StudyExecutionReviewCondition"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Conditions",
      "type": "array"
    },
    "contract_id": {
      "const": "StudyExecutionReviewReceipt/v1",
      "default": "StudyExecutionReviewReceipt/v1",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "exact_runset_artifact_digest_matches_confirmed": {
      "const": true,
      "title": "Exact Runset Artifact Digest Matches Confirmed",
      "type": "boolean"
    },
    "execution_review_receipt_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Execution Review Receipt Digest",
      "type": "string"
    },
    "execution_window_end_utc": {
      "maxLength": 64,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Execution Window End Utc",
      "type": "string"
    },
    "exhaustive_attempt_failure_retry_accounting_confirmed": {
      "const": true,
      "title": "Exhaustive Attempt Failure Retry Accounting Confirmed",
      "type": "boolean"
    },
    "provider_account_evidence_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Account Evidence Digest",
      "type": "string"
    },
    "provider_account_review_scope": {
      "maxLength": 4096,
      "minLength": 32,
      "title": "Provider Account Review Scope",
      "type": "string"
    },
    "provider_account_usage_reconciled": {
      "const": true,
      "title": "Provider Account Usage Reconciled",
      "type": "boolean"
    },
    "provider_log_and_account_review_confirmed": {
      "const": true,
      "title": "Provider Log And Account Review Confirmed",
      "type": "boolean"
    },
    "provider_log_evidence_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Log Evidence Digest",
      "type": "string"
    },
    "provider_log_review_scope": {
      "maxLength": 4096,
      "minLength": 32,
      "title": "Provider Log Review Scope",
      "type": "string"
    },
    "provider_log_time_window_coverage_confirmed": {
      "const": true,
      "title": "Provider Log Time Window Coverage Confirmed",
      "type": "boolean"
    },
    "provider_response_id_matches_confirmed": {
      "const": true,
      "title": "Provider Response Id Matches Confirmed",
      "type": "boolean"
    },
    "provider_serving_fingerprint_absence_acknowledged": {
      "title": "Provider Serving Fingerprint Absence Acknowledged",
      "type": "boolean"
    },
    "provider_serving_fingerprint_availability_reviewed": {
      "const": true,
      "title": "Provider Serving Fingerprint Availability Reviewed",
      "type": "boolean"
    },
    "receipt_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "reviewed_at_utc": {
      "maxLength": 64,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Reviewed At Utc",
      "type": "string"
    },
    "reviewer_identity_authentication": {
      "const": "out_of_band_not_machine_verified",
      "default": "out_of_band_not_machine_verified",
      "title": "Reviewer Identity Authentication",
      "type": "string"
    },
    "reviewer_independence_rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Reviewer Independence Rationale",
      "type": "string"
    },
    "reviewer_independent_of_execution": {
      "const": true,
      "title": "Reviewer Independent Of Execution",
      "type": "boolean"
    },
    "reviewer_pseudonym": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Reviewer Pseudonym",
      "type": "string"
    },
    "schema_name": {
      "const": "real-model-study-execution-review",
      "default": "real-model-study-execution-review",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "0.6.6",
      "default": "0.6.6",
      "title": "Schema Version",
      "type": "string"
    },
    "study_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Study Id",
      "type": "string"
    },
    "study_manifest_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Study Manifest Digest",
      "type": "string"
    },
    "study_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Study Manifest Sha256",
      "type": "string"
    },
    "study_report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Study Report Digest",
      "type": "string"
    },
    "study_report_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Study Report Sha256",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "execution_review_receipt_digest",
    "study_id",
    "study_manifest_digest",
    "study_manifest_sha256",
    "study_report_digest",
    "study_report_sha256",
    "execution_window_end_utc",
    "reviewed_at_utc",
    "reviewer_pseudonym",
    "reviewer_independent_of_execution",
    "reviewer_independence_rationale",
    "provider_log_review_scope",
    "provider_log_evidence_digest",
    "provider_account_review_scope",
    "provider_account_evidence_digest",
    "conditions",
    "provider_log_and_account_review_confirmed",
    "provider_log_time_window_coverage_confirmed",
    "provider_account_usage_reconciled",
    "exhaustive_attempt_failure_retry_accounting_confirmed",
    "provider_response_id_matches_confirmed",
    "exact_runset_artifact_digest_matches_confirmed",
    "provider_serving_fingerprint_availability_reviewed",
    "provider_serving_fingerprint_absence_acknowledged",
    "artifact_kind",
    "schema_version",
    "schema_name",
    "contract_id",
    "contract_version"
  ],
  "title": "StudyExecutionReviewReceipt",
  "type": "object"
}
