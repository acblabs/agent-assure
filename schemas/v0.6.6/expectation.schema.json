{
  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.6/expectation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.6.1",
              "0.6.2",
              "0.6.3",
              "0.6.4",
              "0.6.5",
              "0.6.6"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "material_claim_ids": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
            }
          },
          "required_evidence_refs": {
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}(?![\\s\\S])"
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "schema_version"
              ]
            }
          },
          {
            "properties": {
              "schema_version": {
                "const": "0.6.6"
              }
            },
            "required": [
              "schema_version"
            ]
          }
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "expected_recommendation": {
                "type": "string"
              }
            },
            "required": [
              "expected_recommendation"
            ]
          },
          {
            "properties": {
              "allowed_outcomes": {
                "minItems": 1
              }
            },
            "required": [
              "allowed_outcomes"
            ]
          },
          {
            "properties": {
              "forbidden_outcomes": {
                "minItems": 1
              }
            },
            "required": [
              "forbidden_outcomes"
            ]
          },
          {
            "properties": {
              "required_evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "required_evidence_refs"
            ]
          },
          {
            "properties": {
              "material_claim_ids": {
                "minItems": 1
              }
            },
            "required": [
              "material_claim_ids"
            ]
          },
          {
            "properties": {
              "allowed_providers": {
                "minItems": 1
              }
            },
            "required": [
              "allowed_providers"
            ]
          },
          {
            "properties": {
              "forbidden_providers": {
                "minItems": 1
              }
            },
            "required": [
              "forbidden_providers"
            ]
          },
          {
            "properties": {
              "allowed_tools": {
                "minItems": 1
              }
            },
            "required": [
              "allowed_tools"
            ]
          },
          {
            "properties": {
              "forbidden_tools": {
                "minItems": 1
              }
            },
            "required": [
              "forbidden_tools"
            ]
          },
          {
            "properties": {
              "allowed_tools_override": {
                "const": true
              }
            },
            "required": [
              "allowed_tools_override"
            ]
          },
          {
            "properties": {
              "required_human_review": {
                "const": true
              }
            },
            "required": [
              "required_human_review"
            ]
          }
        ]
      }
    }
  ],
  "properties": {
    "allowed_outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Outcomes",
      "type": "array"
    },
    "allowed_providers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Providers",
      "type": "array"
    },
    "allowed_tools": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Tools",
      "type": "array"
    },
    "allowed_tools_override": {
      "default": false,
      "title": "Allowed Tools Override",
      "type": "boolean"
    },
    "artifact_kind": {
      "const": "expectation",
      "default": "expectation",
      "title": "Artifact Kind",
      "type": "string"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "expectation_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expectation Digest"
    },
    "expectation_id": {
      "minLength": 1,
      "title": "Expectation Id",
      "type": "string"
    },
    "expected_recommendation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Recommendation"
    },
    "forbidden_outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Outcomes",
      "type": "array"
    },
    "forbidden_providers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Providers",
      "type": "array"
    },
    "forbidden_tools": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Tools",
      "type": "array"
    },
    "material_claim_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Material Claim Ids",
      "type": "array"
    },
    "required_evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Evidence Refs",
      "type": "array"
    },
    "required_human_review": {
      "default": false,
      "title": "Required Human Review",
      "type": "boolean"
    },
    "schema_version": {
      "const": "0.6.6",
      "default": "0.6.6",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "expectation_id",
    "case_id",
    "artifact_kind",
    "schema_version"
  ],
  "title": "Expectation",
  "type": "object"
}
