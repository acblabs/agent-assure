    "ComparisonClassification": {
      "enum": [
        "new_failure",
        "resolved_failure",
        "persistent_failure",
        "unchanged",
        "allowed_behavioral_change",
        "allowed_behavioral_and_provenance_change",
        "provenance_only_change",
        "invalid_comparison",
        "not_evaluated"
      ],
      "title": "ComparisonClassification",
      "type": "string"
    },
    "ControlEfficacySemanticState": {
      "enum": [
        "survivor_observed",
        "indeterminate",
        "not_evaluated",
        "all_evaluated_applicable_caught"
      ],
      "title": "ControlEfficacySemanticState",
      "type": "string"
    },
    "EfficacyStratum": {
      "additionalProperties": false,
      "properties": {
        "independent_challenge_eligible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independent Challenge Eligible"
        },
        "kill_rate": {
          "$ref": "#/$defs/ExactRate"
        },
        "state_counts": {
          "$ref": "#/$defs/MutationStateCounts"
        },
        "stratum": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Stratum",
          "type": "string"
        }
      },
      "required": [
        "stratum",
        "state_counts",
        "kill_rate"
      ],
      "title": "EfficacyStratum",
      "type": "object"
    },
    "EvidenceEvaluationBasis": {
      "enum": [
        "deterministic",
        "stochastic",
        "human_reviewed",
        "llm_advisory"
      ],
