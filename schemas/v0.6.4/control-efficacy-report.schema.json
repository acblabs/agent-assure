        "type": "string"
      },
      "maxItems": 256,
      "title": "Required Operator Ids",
      "type": "array"
    },
    "required_survivor_count": {
      "maximum": 256,
      "minimum": 0,
      "title": "Required Survivor Count",
      "type": "integer"
    },
    "required_survivor_operator_ids": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Required Survivor Operator Ids",
      "type": "array"
    },
    "schema_name": {
      "const": "control-efficacy-report",
      "default": "control-efficacy-report",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "0.6.4",
      "default": "0.6.4",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_operator_ids": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Selected Operator Ids",
      "type": "array"
    },
    "semantic_state": {
      "$ref": "#/$defs/ControlEfficacySemanticState"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "state_counts": {
      "$ref": "#/$defs/MutationStateCounts"
    },
    "suite_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Suite Digest",
      "type": "string"
    },
    "survived_operator_count": {
      "maximum": 256,
      "minimum": 0,
      "title": "Survived Operator Count",
      "type": "integer"
    },
    "threat_challenge_rate": {
      "$ref": "#/$defs/ExactRate"
    },
    "threat_coverage": {
      "items": {
        "$ref": "#/$defs/ThreatCoverageItem"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Threat Coverage",
      "type": "array"
    },
    "threat_manifest_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Threat Manifest Digest",
      "type": "string"
    },
    "threat_scope_state": {
      "$ref": "#/$defs/ThreatScopeSemanticState"
    },
    "unknown_applicability_count": {
      "maximum": 4096,
      "minimum": 0,
      "title": "Unknown Applicability Count",
      "type": "integer"
    },
    "unknown_applicability_threat_ids": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 4096,
      "title": "Unknown Applicability Threat Ids",
      "type": "array"
    },
    "unscoped_catalog_threat_count": {
      "maximum": 8192,
      "minimum": 0,
      "title": "Unscoped Catalog Threat Count",
      "type": "integer"
    },
    "unscoped_catalog_threat_ids": {
      "default": [],
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
        "type": "string"
      },
      "maxItems": 8192,
      "title": "Unscoped Catalog Threat Ids",
      "type": "array"
    }
