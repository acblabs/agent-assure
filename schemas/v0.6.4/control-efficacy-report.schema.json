  "required": [
    "report_digest",
    "campaign_digest",
    "source_digest",
    "suite_digest",
    "catalog_id",
    "catalog_digest",
    "threat_manifest_digest",
    "semantic_state",
    "threat_scope_state",
    "canonical_operator_ids",
    "canonical_invariant_families",
    "selected_operator_ids",
    "operator_outcomes",
    "state_counts",
    "applicable_operator_count",
    "caught_operator_count",
    "survived_operator_count",
    "inapplicable_operator_count",
    "invalid_operator_count",
    "invalid_subject_count",
    "execution_error_count",
    "catalog_kill_rate",
    "required_survivor_count",
    "critical_survivor_count",
    "kill_rate_by_invariant_family",
    "kill_rate_by_independence_class",
    "threat_coverage",
    "applicable_threat_category_count",
    "challenged_threat_category_count",
    "independently_challenged_threat_category_count",
    "critical_uncovered_threat_count",
    "unknown_applicability_count",
    "unscoped_catalog_threat_count",
    "threat_challenge_rate",
    "independent_threat_challenge_rate",
    "limitations",
    "artifact_kind",
    "schema_version",
    "schema_name",
    "contract_id",
    "contract_version"
  ],
  "title": "ControlEfficacyReport",
  "type": "object"
}
