          "pattern": "^[a-f0-9]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        },
        "corpus_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Corpus Digest",
          "type": "string"
        },
        "expected_outcome": {
          "$ref": "#/$defs/RAGSensitivityOutcome"
        },
        "expected_recommendation": {
          "$ref": "#/$defs/RAGSensitivityDecision"
        },
        "knowledge_contract_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Knowledge Contract Digest",
          "type": "string"
        },
        "pipeline_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Pipeline Id",
          "type": "string"
        },
        "policy_bundle_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Bundle Digest",
          "type": "string"
        },
        "prompt_manifest_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Manifest Digest",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Provider",
          "type": "string"
        },
        "provider_api_version": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
