            ]
          }
        }
      ],
      "properties": {
        "classification": {
          "$ref": "#/$defs/CouplingClassification"
        },
        "intentionally_different": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CouplingCondition"
          },
          "maxItems": 64,
          "title": "Intentionally Different",
          "type": "array"
        },
        "not_shared": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CouplingCondition"
          },
          "maxItems": 64,
          "title": "Not Shared",
          "type": "array"
        },
        "pairing_identity_verified": {
          "title": "Pairing Identity Verified",
          "type": "boolean"
        },
        "provider_seed_sharing_evidence_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "const": null,
          "default": null,
          "title": "Provider Seed Sharing Evidence Digest"
        },
        "requested_provider_seed": {
          "default": false,
          "title": "Requested Provider Seed",
          "type": "boolean"
        },
        "shared": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CouplingCondition"
          },
          "maxItems": 64,
          "title": "Shared",
          "type": "array"
        },
        "stochastic_dimensions": {
          "items": {
            "$ref": "#/$defs/CouplingCondition"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Stochastic Dimensions",
          "type": "array"
        },
        "unknown": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CouplingCondition"
          },
          "maxItems": 64,
          "title": "Unknown",
          "type": "array"
        },
        "variance_reduction_claim_permitted": {
          "const": false,
          "default": false,
          "title": "Variance Reduction Claim Permitted",
          "type": "boolean"
        }
      },
      "required": [
        "pairing_identity_verified",
        "stochastic_dimensions",
        "classification"
      ],
      "title": "CouplingDescriptor",
      "type": "object"
    },
    "RAGSensitivityAuthorityAssignment": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Claim Id",
          "type": "string"
        },
        "corpus_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Corpus Digest",
          "type": "string"
        },
        "expected_decision": {
          "$ref": "#/$defs/RAGSensitivityDecision"
        },
        "expected_outcome": {
          "$ref": "#/$defs/RAGSensitivityOutcome"
        },
        "governing_content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Governing Content Digest",
          "type": "string"
        },
        "governing_ref_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Governing Ref Id",
          "type": "string"
        },
        "governing_source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Governing Source Id",
          "type": "string"
        }
      },
      "required": [
        "corpus_digest",
        "expected_decision",
        "expected_outcome",
        "governing_source_id",
        "governing_ref_id",
        "governing_content_digest",
        "claim_id"
      ],
      "title": "RAGSensitivityAuthorityAssignment",
      "type": "object"
    },
    "RAGSensitivityCaseAuthorityBinding": {
      "additionalProperties": false,
      "description": "Exact authority assignment pair for one explicitly covered case.",
      "properties": {
        "assignments": {
          "items": {
            "$ref": "#/$defs/RAGSensitivityAuthorityAssignment"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Assignments",
          "type": "array"
        },
        "case_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Case Id",
          "type": "string"
        },
        "query_family_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Query Family Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "query_family_id",
        "assignments"
      ],
      "title": "RAGSensitivityCaseAuthorityBinding",
      "type": "object"
    },
    "RAGSensitivityDecision": {
      "enum": [
        "approve",
        "deny",
        "escalate"
      ],
      "title": "RAGSensitivityDecision",
      "type": "string"
    },
    "RAGSensitivityOutcome": {
      "enum": [
        "approved",
        "denied",
        "escalated"
      ],
      "title": "RAGSensitivityOutcome",
      "type": "string"
    },
    "SensitivityArmBinding": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Adapter Id",
          "type": "string"
        },
