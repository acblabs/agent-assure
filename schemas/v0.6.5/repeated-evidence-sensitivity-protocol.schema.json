  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.5/repeated-evidence-sensitivity-protocol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "stochastic_live"
          },
          "interpretation": {
            "const": "confirmatory"
          }
        },
        "required": [
          "execution_mode",
          "interpretation"
        ]
      },
      "then": {
        "properties": {
          "baseline_arm": {
            "properties": {
              "adapter_id": {
                "enum": [
                  "openai-chat-completions"
                ]
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "case_authority_bindings": {
            "minItems": 1
          },
          "counterfactual_arm": {
            "properties": {
              "adapter_id": {
                "enum": [
                  "openai-chat-completions"
                ]
              }
            },
            "required": [
              "adapter_id"
            ]
          },
          "coupling": {
            "properties": {
              "classification": {
                "not": {
                  "enum": [
                    "unpaired",
                    "unknown"
                  ]
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "enum": [
                      "provider_sampling_randomness",
                      "temporal_execution_order"
                    ]
                  }
                }
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        "required": [
          "case_authority_bindings"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "stochastic_live"
          }
        },
        "required": [
          "execution_mode"
        ]
      },
      "then": {
        "properties": {
          "coupling": {
            "allOf": [
              {
                "properties": {
                  "stochastic_dimensions": {
                    "contains": {
                      "const": "provider_sampling_randomness"
                    }
                  }
                }
              },
              {
                "properties": {
                  "stochastic_dimensions": {
                    "contains": {
                      "const": "temporal_execution_order"
                    }
                  }
                }
              },
              {
                "properties": {
                  "shared": {
                    "not": {
                      "contains": {
                        "enum": [
                          "provider_sampling_randomness",
                          "temporal_execution_order"
                        ]
                      }
                    }
                  }
                }
              },
              {
                "anyOf": [
                  {
                    "properties": {
                      "intentionally_different": {
                        "contains": {
                          "const": "provider_sampling_randomness"
                        }
                      }
                    },
                    "required": [
                      "intentionally_different"
                    ]
                  },
                  {
                    "properties": {
                      "not_shared": {
                        "contains": {
                          "const": "provider_sampling_randomness"
                        }
                      }
                    },
                    "required": [
                      "not_shared"
                    ]
                  },
                  {
                    "properties": {
                      "unknown": {
                        "contains": {
                          "const": "provider_sampling_randomness"
                        }
                      }
                    },
                    "required": [
                      "unknown"
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "properties": {
                      "intentionally_different": {
                        "contains": {
                          "const": "temporal_execution_order"
                        }
                      }
                    },
                    "required": [
                      "intentionally_different"
                    ]
                  },
                  {
                    "properties": {
                      "not_shared": {
                        "contains": {
                          "const": "temporal_execution_order"
                        }
                      }
                    },
                    "required": [
                      "not_shared"
                    ]
                  },
                  {
                    "properties": {
                      "unknown": {
                        "contains": {
                          "const": "temporal_execution_order"
                        }
                      }
                    },
                    "required": [
                      "unknown"
                    ]
                  }
                ]
              }
            ],
            "required": [
              "stochastic_dimensions"
            ]
          }
        }
      }
    }
