{
  "$defs": {
    "BinaryPairedDesignPlan": {
      "additionalProperties": false,
      "properties": {
        "achieved_power": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Achieved Power",
          "type": "string"
        },
        "achieved_type_i_error": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Achieved Type I Error",
          "type": "string"
        },
        "adjusted_alpha": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Adjusted Alpha",
          "type": "string"
        },
        "alternative_response_rate": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Alternative Response Rate",
          "type": "string"
        },
        "analysis_method": {
          "const": "cluster_binary_exact",
          "default": "cluster_binary_exact",
          "title": "Analysis Method",
          "type": "string"
        },
        "cluster_endpoint_aggregation": {
          "const": "all_planned_pairs_expected_response",
          "default": "all_planned_pairs_expected_response",
          "title": "Cluster Endpoint Aggregation",
          "type": "string"
        },
        "confirmatory_cluster_frame": {
          "const": "all_frozen_planned_clusters",
          "default": "all_frozen_planned_clusters",
          "title": "Confirmatory Cluster Frame",
          "type": "string"
        },
        "critical_cluster_responses": {
          "minimum": 1,
          "title": "Critical Cluster Responses",
          "type": "integer"
        },
        "desired_power": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Desired Power",
          "type": "string"
        },
        "exchangeability_assumption": {
          "const": "independent_exchangeable_binary_cluster_endpoints",
          "default": "independent_exchangeable_binary_cluster_endpoints",
          "title": "Exchangeability Assumption",
          "type": "string"
        },
        "familywise_alpha": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Familywise Alpha",
          "type": "string"
        },
        "maximum_exclusion_rate": {
          "default": "0.000000",
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Maximum Exclusion Rate",
          "type": "string"
        },
        "minimum_detectable_difference": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Minimum Detectable Difference",
          "type": "string"
        },
        "monte_carlo_diagnostic_threshold_clusters": {
          "default": 20,
          "maximum": 10000,
          "minimum": 2,
          "title": "Monte Carlo Diagnostic Threshold Clusters",
          "type": "integer"
        },
        "monte_carlo_resamples": {
          "default": 1000,
          "maximum": 1000000,
          "minimum": 1000,
          "title": "Monte Carlo Resamples",
          "type": "integer"
        },
        "non_analyzable_cluster_policy": {
          "const": "score_zero",
          "default": "score_zero",
          "title": "Non Analyzable Cluster Policy",
          "type": "string"
        },
        "null_response_rate": {
          "pattern": "^(0|1)\\.[0-9]{6}$",
          "title": "Null Response Rate",
          "type": "string"
        },
        "planned_inferential_clusters": {
          "maximum": 10000,
          "minimum": 2,
          "title": "Planned Inferential Clusters",
          "type": "integer"
        }
      },
      "required": [
        "familywise_alpha",
        "adjusted_alpha",
        "desired_power",
        "null_response_rate",
        "alternative_response_rate",
        "minimum_detectable_difference",
        "planned_inferential_clusters",
        "critical_cluster_responses",
        "achieved_type_i_error",
        "achieved_power"
      ],
      "title": "BinaryPairedDesignPlan",
      "type": "object"
    },
    "CaseClusterBinding": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Case Id",
          "type": "string"
        },
        "cluster_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "title": "Cluster Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "cluster_id"
      ],
      "title": "CaseClusterBinding",
      "type": "object"
    },
    "CouplingClassification": {
      "enum": [
        "fully_coupled",
        "partially_coupled",
        "nominally_paired",
        "unpaired",
        "unknown"
      ],
      "title": "CouplingClassification",
      "type": "string"
    },
    "CouplingCondition": {
      "enum": [
        "case_identity",
        "non_intervened_fixture_fields",
        "tool_schema_digest",
        "provider_configuration",
        "governing_corpus_digest",
        "provider_sampling_randomness",
        "retrieval_randomness",
        "tool_randomness",
        "temporal_execution_order",
        "deterministic_fixture_execution"
      ],
      "title": "CouplingCondition",
      "type": "string"
    },
    "CouplingDescriptor": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pairing_identity_verified": {
                "const": false
              }
            },
            "required": [
              "pairing_identity_verified"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "const": "unpaired"
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "pairing_identity_verified": {
                "const": true
              }
            },
            "required": [
              "pairing_identity_verified"
            ]
          },
          "then": {
            "properties": {
              "classification": {
                "not": {
                  "const": "unpaired"
                }
              }
            },
            "required": [
              "classification"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "case_identity"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "case_identity"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "case_identity"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "case_identity"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "case_identity"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "non_intervened_fixture_fields"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "non_intervened_fixture_fields"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "non_intervened_fixture_fields"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "non_intervened_fixture_fields"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "non_intervened_fixture_fields"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "tool_schema_digest"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "tool_schema_digest"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "tool_schema_digest"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "tool_schema_digest"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "tool_schema_digest"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "provider_configuration"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "provider_configuration"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "provider_configuration"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "provider_configuration"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "provider_configuration"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "governing_corpus_digest"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "governing_corpus_digest"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "governing_corpus_digest"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "governing_corpus_digest"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "governing_corpus_digest"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "provider_sampling_randomness"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "provider_sampling_randomness"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "provider_sampling_randomness"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "provider_sampling_randomness"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "provider_sampling_randomness"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "retrieval_randomness"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "retrieval_randomness"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "retrieval_randomness"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "retrieval_randomness"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "retrieval_randomness"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "tool_randomness"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "tool_randomness"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "tool_randomness"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "tool_randomness"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "tool_randomness"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "temporal_execution_order"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "temporal_execution_order"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "temporal_execution_order"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "temporal_execution_order"
                }
              },
              "unknown": {
                "not": {
                  "contains": {
                    "const": "temporal_execution_order"
                  }
                }
              }
            },
            "required": [
              "shared"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "fully_coupled"
              },
              "stochastic_dimensions": {
                "contains": {
                  "const": "deterministic_fixture_execution"
                }
              }
            },
            "required": [
              "classification",
              "stochastic_dimensions"
            ]
          },
          "then": {
            "properties": {
              "intentionally_different": {
                "not": {
                  "contains": {
                    "const": "deterministic_fixture_execution"
                  }
                }
              },
              "not_shared": {
                "not": {
                  "contains": {
                    "const": "deterministic_fixture_execution"
                  }
                }
              },
              "shared": {
                "contains": {
                  "const": "deterministic_fixture_execution"
                }
              },
              "unknown": {
