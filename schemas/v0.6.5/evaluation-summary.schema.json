{
  "$defs": {
    "EnvironmentInfo": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "environment-info",
          "default": "environment-info",
          "title": "Artifact Kind",
          "type": "string"
        },
        "dependency_inventory_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Inventory Digest"
        },
        "dependency_inventory_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Inventory Path"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "git_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Dirty"
        },
        "installed_packages": {
          "default": [],
          "items": {
            "$ref": "#/$defs/InstalledPackage"
          },
          "title": "Installed Packages",
          "type": "array"
        },
        "lockfile_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lockfile Digest"
        },
        "lockfile_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lockfile Path"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "const": "0.6.5",
          "default": "0.6.5",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "python_version",
        "artifact_kind",
        "schema_version"
      ],
      "title": "EnvironmentInfo",
      "type": "object"
    },
    "EvaluationGateProfileContext": {
      "additionalProperties": false,
      "description": "Complete scoring-relevant GateProfile projection for deterministic replay.",
      "properties": {
        "fail_on_not_evaluated": {
          "title": "Fail On Not Evaluated",
          "type": "boolean"
        },
        "fail_on_warn": {
          "title": "Fail On Warn",
          "type": "boolean"
        },
        "fail_reason_codes": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "maxItems": 22,
          "title": "Fail Reason Codes",
          "type": "array"
        },
        "fail_severities": {
          "items": {
            "$ref": "#/$defs/Severity"
          },
          "maxItems": 4,
          "title": "Fail Severities",
          "type": "array"
        },
        "profile_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "fail_severities",
        "fail_reason_codes",
        "fail_on_warn",
        "fail_on_not_evaluated"
      ],
      "title": "EvaluationGateProfileContext",
      "type": "object"
    },
    "EvaluationReplayContext": {
      "additionalProperties": false,
      "description": "Authenticated, scoring-complete inputs for exact evaluation replay.",
      "properties": {
        "evaluation_date": {
          "format": "date",
          "title": "Evaluation Date",
          "type": "string"
        },
        "gate_profile": {
          "$ref": "#/$defs/EvaluationGateProfileContext"
        },
        "report_mode": {
          "default": "full",
          "enum": [
            "full",
            "fail-fast"
          ],
          "title": "Report Mode",
          "type": "string"
        },
        "suite_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Suite Digest",
          "type": "string"
        },
        "waivers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvaluationWaiverContext"
          },
          "maxItems": 4096,
          "title": "Waivers",
          "type": "array"
        }
      },
      "required": [
        "suite_digest",
        "gate_profile",
        "evaluation_date"
      ],
      "title": "EvaluationReplayContext",
      "type": "object"
    },
    "EvaluationWaiverContext": {
      "additionalProperties": false,
      "description": "Privacy-minimized waiver fields that can affect evaluation semantics.",
      "properties": {
        "artifact_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "expires_on": {
          "format": "date",
          "title": "Expires On",
          "type": "string"
        },
        "finding_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "waiver_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Waiver Id",
          "type": "string"
        }
      },
      "required": [
        "waiver_id",
        "reason_code",
        "finding_id",
        "artifact_digest",
        "expires_on"
      ],
      "title": "EvaluationWaiverContext",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.6.3",
                  "0.6.4",
                  "0.6.5"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "finding_id": {
                "minLength": 1
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_kind": {
          "const": "finding",
          "default": "finding",
          "title": "Artifact Kind",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "control_id": {
          "default": "",
          "title": "Control Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "message": {
          "maxLength": 8192,
          "title": "Message",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "schema_version": {
          "const": "0.6.5",
          "default": "0.6.5",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/GateState"
        },
        "target": {
          "default": "",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "case_id",
        "state",
        "reason_code",
        "message",
        "artifact_kind",
        "schema_version"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GateState": {
      "enum": [
        "pass",
        "fail",
        "warn",
        "not_evaluated"
      ],
      "title": "GateState",
      "type": "string"
    },
    "InstalledPackage": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "const": "installed-package",
          "default": "installed-package",
          "title": "Artifact Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "0.6.5",
          "default": "0.6.5",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "artifact_kind",
        "schema_version"
      ],
      "title": "InstalledPackage",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "EXPECTED_OUTCOME_MISMATCH",
        "FORBIDDEN_OUTCOME",
        "MATERIAL_CLAIM_MISSING_EVIDENCE",
        "EVIDENCE_PROVENANCE_MISMATCH",
        "REQUIRED_SOURCE_MISSING",
        "POLICY_FAILED",
        "REQUIRED_HUMAN_REVIEW_ABSENT",
        "REVIEW_BOUNDARY_FAILED",
        "FORBIDDEN_PROVIDER",
        "FORBIDDEN_TOOL",
        "STRUCTURED_OUTPUT_INVALID",
        "REDACTION_FAILED",
        "RAW_SENSITIVE_CONTENT",
        "PROMPT_INJECTION_BOUNDARY",
        "RUNTIME_FAILED",
        "RUNSET_INCOMPLETE",
        "VALID_RECORD_MISSING",
        "FIXTURE_EQUIVALENCE_FAILED",
        "NON_NFC_STRING",
        "NON_FINITE_NUMBER",
        "LLM_JUDGE_VERDICT_BEARING_NOT_SUPPORTED",
        "NOT_EVALUATED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "blocker"
      ],
      "title": "Severity",
      "type": "string"
    },
    "UsageSummary": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "0.3.1"
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cost_basis_ids"
                  ]
                },
                {
                  "required": [
                    "pricing_snapshot_ids"
                  ]
                },
                {
                  "required": [
                    "pricing_snapshot_digests"
                  ]
                },
                {
                  "required": [
                    "cost_observation_count"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimated_cost_microusd": {
                "type": "integer"
              }
            },
            "required": [
              "estimated_cost_microusd"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "const": "USD"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_kind": {
          "const": "usage-summary",
          "default": "usage-summary",
          "title": "Artifact Kind",
          "type": "string"
        },
        "cost_basis_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Cost Basis Ids",
          "type": "array"
        },
        "cost_observation_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Observation Count"
        },
        "currency": {
          "default": "USD",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "estimated_cost_microusd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Microusd"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "pricing_snapshot_digests": {
          "default": [],
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "title": "Pricing Snapshot Digests",
          "type": "array"
        },
        "pricing_snapshot_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Pricing Snapshot Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "0.4.3",
          "default": "0.4.3",
          "title": "Schema Version",
          "type": "string"
        },
        "total_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Latency Ms"
        },
        "total_retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Retries"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "total_tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tool Calls"
        }
      },
      "required": [
        "artifact_kind",
        "schema_version"
      ],
      "title": "UsageSummary",
      "type": "object"
    }
  },
  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.5/evaluation-summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.2.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "usage_summary"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.6.3",
              "0.6.4",
              "0.6.5"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "runset_id": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.6.5"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "runset_digest": {
            "type": "string"
          }
        },
        "required": [
          "runset_digest"
        ]
      }
    },
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "privacy_profile_id"
              ]
            },
            {
              "required": [
                "privacy_profile_digest"
              ]
            }
          ]
        }
      },
      "if": {
        "anyOf": [
          {
            "not": {
              "required": [
                "schema_version"
              ]
            }
          },
          {
            "properties": {
              "schema_version": {
                "enum": [
                  "0.5.0",
                  "0.6.0",
                  "0.6.1",
                  "0.6.2",
                  "0.6.3",
                  "0.6.4",
                  "0.6.5"
                ]
              }
            },
            "required": [
              "schema_version"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "privacy_profile_id",
          "privacy_profile_digest"
        ]
      }
    }
  ],
  "properties": {
    "artifact_kind": {
      "const": "evaluation-summary",
      "default": "evaluation-summary",
      "title": "Artifact Kind",
      "type": "string"
    },
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "privacy_profile_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Privacy Profile Digest",
      "type": "string"
    },
    "privacy_profile_id": {
      "minLength": 1,
      "title": "Privacy Profile Id",
      "type": "string"
    },
    "replay_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationReplayContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Scoring-relevant suite, gate-profile, waiver, date, and report-mode inputs emitted by the first-party evaluator for exact source replay."
    },
    "runset_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Canonical digest of the evaluated RunSet when the producer can authenticate that source identity. The first-party evaluator emits it so packet graph evidence can share one authenticated run-set subject.",
      "title": "Runset Digest"
    },
    "runset_id": {
      "title": "Runset Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.6.5",
      "default": "0.6.5",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/GateState"
    },
    "usage_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "runset_id",
    "state",
    "artifact_kind",
    "schema_version"
  ],
  "title": "EvaluationSummary",
  "type": "object"
}
