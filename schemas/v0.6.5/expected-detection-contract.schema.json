{
  "$comment": "JSON Schema enforces the finite control vocabulary and target-ID uniqueness. Canonical target-ID ordering, required-selector membership in target_control_ids, and required/prohibited selector disjointness are relational constraints enforced by the runtime model because JSON Schema 2020-12 cannot express them directly.",
  "$defs": {
    "FindingSelector": {
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Control Id",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "control_id",
        "reason_code"
      ],
      "title": "FindingSelector",
      "type": "object"
    },
    "GateEffect": {
      "enum": [
        "block",
        "review",
        "informational",
        "ignore"
      ],
      "title": "GateEffect",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "EXPECTED_OUTCOME_MISMATCH",
        "FORBIDDEN_OUTCOME",
        "MATERIAL_CLAIM_MISSING_EVIDENCE",
        "EVIDENCE_PROVENANCE_MISMATCH",
        "REQUIRED_SOURCE_MISSING",
        "POLICY_FAILED",
        "REQUIRED_HUMAN_REVIEW_ABSENT",
        "REVIEW_BOUNDARY_FAILED",
        "FORBIDDEN_PROVIDER",
        "FORBIDDEN_TOOL",
        "STRUCTURED_OUTPUT_INVALID",
        "REDACTION_FAILED",
        "RAW_SENSITIVE_CONTENT",
        "PROMPT_INJECTION_BOUNDARY",
        "RUNTIME_FAILED",
        "RUNSET_INCOMPLETE",
        "VALID_RECORD_MISSING",
        "FIXTURE_EQUIVALENCE_FAILED",
        "NON_NFC_STRING",
        "NON_FINITE_NUMBER",
        "LLM_JUDGE_VERDICT_BEARING_NOT_SUPPORTED",
        "NOT_EVALUATED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RequiredFindingAlternatives": {
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "items": {
            "$ref": "#/$defs/FindingSelector"
          },
          "minItems": 1,
          "title": "Any Of",
          "type": "array"
        }
      },
      "required": [
        "any_of"
      ],
      "title": "RequiredFindingAlternatives",
      "type": "object"
    }
  },
  "$id": "https://acblabs.github.io/agent-assure/schemas/v0.6.5/expected-detection-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "properties": {
        "prohibited_substitutes": {
          "items": {
            "properties": {
              "control_id": {
                "enum": [
                  "evidence_provenance_identity",
                  "evidence_required",
                  "human_review_required",
                  "material_claims_have_evidence",
                  "prompt_injection_control_boundary",
                  "provider_review_boundary",
                  "redaction_required",
                  "runset_completion_required",
                  "runtime_success_required",
                  "structured_output_required",
                  "tool_allowlist",
                  "valid_record_required"
                ]
              }
            }
          }
        },
        "required_findings": {
          "properties": {
            "any_of": {
              "items": {
                "properties": {
                  "control_id": {
                    "enum": [
                      "evidence_provenance_identity",
                      "evidence_required",
                      "human_review_required",
                      "material_claims_have_evidence",
                      "prompt_injection_control_boundary",
                      "provider_review_boundary",
                      "redaction_required",
                      "runset_completion_required",
                      "runtime_success_required",
                      "structured_output_required",
                      "tool_allowlist",
                      "valid_record_required"
                    ]
                  }
                }
              }
            }
          }
        },
        "target_control_ids": {
          "items": {
            "enum": [
              "evidence_provenance_identity",
              "evidence_required",
              "human_review_required",
              "material_claims_have_evidence",
              "prompt_injection_control_boundary",
              "provider_review_boundary",
              "redaction_required",
              "runset_completion_required",
              "runtime_success_required",
              "structured_output_required",
              "tool_allowlist",
              "valid_record_required"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  ],
  "properties": {
    "artifact_kind": {
      "const": "expected-detection-contract",
      "default": "expected-detection-contract",
      "title": "Artifact Kind",
      "type": "string"
    },
    "contract_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contract Digest",
      "type": "string"
    },
    "contract_id": {
      "const": "ExpectedDetectionContract/v1",
      "default": "ExpectedDetectionContract/v1",
      "title": "Contract Id",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "expected_gate_effect": {
      "$ref": "#/$defs/GateEffect"
    },
    "operator_id": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Operator Id",
      "type": "string"
    },
    "prohibited_substitutes": {
      "items": {
        "$ref": "#/$defs/FindingSelector"
      },
      "title": "Prohibited Substitutes",
      "type": "array"
    },
    "required_findings": {
      "$ref": "#/$defs/RequiredFindingAlternatives"
    },
    "schema_name": {
      "const": "expected-detection-contract",
      "default": "expected-detection-contract",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "0.6.5",
      "default": "0.6.5",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary_findings_allowed": {
      "title": "Secondary Findings Allowed",
      "type": "boolean"
    },
    "target_control_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Control Ids",
      "type": "array"
    }
  },
  "required": [
    "contract_digest",
    "operator_id",
    "target_control_ids",
    "required_findings",
    "prohibited_substitutes",
    "expected_gate_effect",
    "secondary_findings_allowed",
    "artifact_kind",
    "schema_version",
    "schema_name",
    "contract_id",
    "contract_version"
  ],
  "title": "ExpectedDetectionContract",
  "type": "object"
}
