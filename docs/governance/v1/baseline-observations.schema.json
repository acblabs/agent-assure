{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acblabs.github.io/agent-assure/governance/v1/baseline-observations.schema.json",
  "title": "Agent Assure S1 baseline observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "spec_revision",
    "inventory_completed_at_utc",
    "trusted_time_basis",
    "repository",
    "roadmap",
    "environment",
    "cli_reservation",
    "dependency_locks",
    "validation_runs",
    "limitations",
    "observations_digest"
  ],
  "properties": {
    "format": { "const": "agent-assure-baseline-observations/1" },
    "spec_revision": { "const": "6.5" },
    "inventory_completed_at_utc": { "$ref": "#/$defs/utc" },
    "trusted_time_basis": { "$ref": "#/$defs/nonempty" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_remote_url",
        "fetch_command",
        "fetch_observed_at_utc",
        "fetch_exit_code",
        "fetch_output_summary",
        "origin_main_commit",
        "baseline_tag_name",
        "baseline_tag_object",
        "baseline_tag_commit",
        "tag_main_delta",
        "branch_name",
        "branch_base_commit"
      ],
      "properties": {
        "approved_remote_url": { "type": "string", "format": "uri", "maxLength": 512 },
        "fetch_command": { "$ref": "#/$defs/nonempty" },
        "fetch_observed_at_utc": { "$ref": "#/$defs/utc" },
        "fetch_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "fetch_output_summary": { "$ref": "#/$defs/nonempty" },
        "origin_main_commit": { "$ref": "#/$defs/gitCommit" },
        "baseline_tag_name": { "const": "v0.7.0" },
        "baseline_tag_object": { "$ref": "#/$defs/gitCommit" },
        "baseline_tag_commit": { "$ref": "#/$defs/gitCommit" },
        "tag_main_delta": { "enum": ["none", "different"] },
        "branch_name": { "$ref": "#/$defs/nonempty" },
        "branch_base_commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_digest", "local_only", "git_index_tracked"],
      "properties": {
        "raw_digest": { "$ref": "#/$defs/digest" },
        "local_only": { "const": true },
        "git_index_tracked": { "const": false }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "python_version",
        "pip_check",
        "time_attestation",
        "trusted_executables_observed_at_utc",
        "trusted_executables",
        "trusted_python_runtime_observed_at_utc",
        "trusted_python_runtime"
      ],
      "properties": {
        "platform": { "$ref": "#/$defs/nonempty" },
        "python_version": { "$ref": "#/$defs/nonempty" },
        "pip_check": { "$ref": "#/$defs/commandResult" },
        "time_attestation": { "$ref": "#/$defs/commandResult" },
        "trusted_executables_observed_at_utc": { "$ref": "#/$defs/utc" },
        "trusted_executables": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trustedExecutable" }
        },
        "trusted_python_runtime_observed_at_utc": { "$ref": "#/$defs/utc" },
        "trusted_python_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_profile",
            "launcher_profile",
            "implementation",
            "version",
            "cache_tag",
            "python_executable",
            "python_dll",
            "base_runtime_file_count",
            "base_runtime_size_bytes",
            "base_runtime_sha256",
            "site_packages_path",
            "runtime_roots",
            "runtime_file_count",
            "runtime_size_bytes",
            "runtime_sha256",
            "site_startup_disabled",
            "bytecode_writes_disabled",
            "fresh_prestart_pycache_prefix_required"
          ],
          "properties": {
            "execution_profile": { "const": "powershell-preverified-cpython-3.12.13-I-S-B/v1" },
            "launcher_profile": { "const": "agent-assure-s1-powershell-runtime-launcher/v1" },
            "implementation": { "const": "CPython" },
            "version": { "const": "3.12.13" },
            "cache_tag": { "const": "cpython-312" },
            "python_executable": { "$ref": "#/$defs/trustedFile" },
            "python_dll": { "$ref": "#/$defs/trustedFile" },
            "base_runtime_file_count": { "const": 2766 },
            "base_runtime_size_bytes": { "const": 54224916 },
            "base_runtime_sha256": {
              "const": "sha256:4e2b76aeadc0f328a00b520b2dc6cb4991486eaa9496b18d5035bac7b63ea152"
            },
            "site_packages_path": { "$ref": "#/$defs/nonempty" },
            "runtime_roots": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "uniqueItems": true,
              "prefixItems": [
                { "const": "attr" },
                { "const": "attrs" },
                { "const": "jsonschema" },
                { "const": "jsonschema_specifications" },
                { "const": "referencing" },
                { "const": "rfc8785" },
                { "const": "rpds" },
                { "const": "typing_extensions.py" }
              ],
              "items": false
            },
            "runtime_file_count": { "const": 116 },
            "runtime_size_bytes": { "const": 1581377 },
            "runtime_sha256": {
              "const": "sha256:a8a4451bde03104cc2a6dae38a30ae0bef63f717a39e5b996e05c10b83fdae02"
            },
            "site_startup_disabled": { "const": true },
            "bytecode_writes_disabled": { "const": true },
            "fresh_prestart_pycache_prefix_required": { "const": true }
          }
        }
      }
    },
    "cli_reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_command",
        "collision_found",
        "probe_exit_code",
        "observed_at_utc",
        "summary"
      ],
      "properties": {
        "reserved_command": { "const": "agent-assure test activate" },
        "collision_found": { "const": false },
        "probe_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "observed_at_utc": { "$ref": "#/$defs/utc" },
        "summary": { "$ref": "#/$defs/nonempty" }
      }
    },
    "dependency_locks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "enum": ["requirements.lock", "requirements-langgraph.lock", "requirements-adk.lock"] },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "validation_runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/validationRun" }
    },
    "limitations": { "$ref": "#/$defs/stringSet" },
    "observations_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "outcome", "exit_code", "observed_at_utc", "summary"],
      "properties": {
        "command": { "$ref": "#/$defs/nonempty" },
        "outcome": { "enum": ["passed", "failed", "unavailable"] },
        "exit_code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        "observed_at_utc": { "$ref": "#/$defs/utc" },
        "summary": { "$ref": "#/$defs/nonempty" }
      }
    },
    "trustedExecutable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "absolute_path", "size_bytes", "sha256"],
      "properties": {
        "name": { "enum": ["git", "git-remote-https", "ssh-keygen"] },
        "absolute_path": { "$ref": "#/$defs/nonempty" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "trustedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute_path", "size_bytes", "sha256"],
      "properties": {
        "absolute_path": { "$ref": "#/$defs/nonempty" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "validationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "command",
        "outcome",
        "exit_code",
        "timeout_seconds",
        "observed_at_utc",
        "summary"
      ],
      "properties": {
        "check_id": { "type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 128 },
        "command": { "$ref": "#/$defs/nonempty" },
        "outcome": { "enum": ["passed", "failed", "timed_out"] },
        "exit_code": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 255 },
            { "type": "null" }
          ]
        },
        "timeout_seconds": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 86400 },
            { "type": "null" }
          ]
        },
        "observed_at_utc": { "$ref": "#/$defs/utc" },
        "summary": { "$ref": "#/$defs/nonempty" }
      }
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    }
  }
}
