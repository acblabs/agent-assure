{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acblabs.github.io/agent-assure/governance/v1/sprint2/s1-successor-host.schema.json",
  "title": "Frozen host successor and S2 development governance wire contract",
  "$comment": "Schema validity never grants trust. Frozen external bootstrap and scoped exact-byte human signatures are mandatory. All references stay local.",
  "oneOf": [
    {
      "$ref": "#/$defs/bootstrap"
    },
    {
      "$ref": "#/$defs/request"
    }
  ],
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "key_id",
        "public_key",
        "competence_scopes",
        "roles",
        "conflicts",
        "review_capacity",
        "valid_from_utc",
        "valid_until_utc",
        "mode",
        "independence"
      ],
      "properties": {
        "person_id": {
          "const": "acblabs"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "public_key": {
          "const": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP7Bgeqxj82OCpkAsF4Qzby2m5PfOnh4lNKzl3fXZ/uB"
        },
        "competence_scopes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "repository_maintainer",
              "technical_lead"
            ]
          }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "review_capacity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "valid_from_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "maxLength": 27
        },
        "valid_until_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "maxLength": 27
        },
        "mode": {
          "const": "maintainer_development"
        },
        "independence": {
          "const": "NO_INDEPENDENT_REVIEW"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "signature_envelope"
      ],
      "properties": {
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "purpose",
            "authorization_effect",
            "trust",
            "policy",
            "policy_digest",
            "implementation_inventory",
            "local_check_expansion",
            "exclusions",
            "actual_signature_time_claimed"
          ],
          "properties": {
            "format": {
              "const": "agent-assure-s1-successor-host-bootstrap/3"
            },
            "purpose": {
              "const": "scoped_development_trust_and_bootstrap"
            },
            "authorization_effect": {
              "const": "development_governance_only"
            },
            "trust": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "person_id",
                "key_id",
                "public_key",
                "competence_scopes",
                "roles",
                "conflicts",
                "review_capacity",
                "valid_from_utc",
                "valid_until_utc",
                "mode",
                "independence",
                "implementation_binding",
                "local_check_expansion_digest",
                "capture_repository_root",
                "powershell_identity"
              ],
              "properties": {
                "person_id": {
                  "const": "acblabs"
                },
                "key_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "public_key": {
                  "const": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIP7Bgeqxj82OCpkAsF4Qzby2m5PfOnh4lNKzl3fXZ/uB"
                },
                "competence_scopes": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "roles": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "repository_maintainer",
                      "technical_lead"
                    ]
                  }
                },
                "conflicts": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "review_capacity": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "valid_from_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                  "maxLength": 27
                },
                "valid_until_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                  "maxLength": 27
                },
                "mode": {
                  "const": "maintainer_development"
                },
                "independence": {
                  "const": "NO_INDEPENDENT_REVIEW"
                },
                "implementation_binding": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "maxLength": 71
                },
                "local_check_expansion_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "maxLength": 71
                },
                "capture_repository_root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "powershell_identity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "size_bytes",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "const": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4194304
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "maxLength": 71
                    }
                  }
                }
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "trust_snapshot_digest",
                "signer_person_id",
                "workflow_digest",
                "expected_validator_digest",
                "required_ci_instances",
                "required_local_checks",
                "required_native_controls",
                "predecessor_tag_objects",
                "maximum_age_seconds",
                "finalization_window_seconds"
              ],
              "properties": {
                "trust_snapshot_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "maxLength": 71
                },
                "signer_person_id": {
                  "const": "acblabs"
                },
                "workflow_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "maxLength": 71
                },
                "expected_validator_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "maxLength": 71
                },
                "required_ci_instances": {
                  "type": "array",
                  "minItems": 21,
                  "maxItems": 256,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required_local_checks": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required_native_controls": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "predecessor_tag_objects": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$",
                        "maxLength": 40
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "maximum_age_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2592000
                },
                "finalization_window_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                }
              }
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "maxLength": 71
            },
            "implementation_inventory": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "size_bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4194304
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "maxLength": 71
                  }
                }
              }
            },
            "local_check_expansion": {
              "type": "object"
            },
            "exclusions": {
              "const": [
                "no_independent_review",
                "no_method_admission",
                "no_runtime_or_release_authorization"
              ]
            },
            "actual_signature_time_claimed": {
              "const": false
            }
          }
        },
        "signature_envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "namespace",
            "signer_person_id",
            "key_id",
            "signature"
          ],
          "properties": {
            "profile": {
              "const": "openssh-sshsig-ed25519/v1"
            },
            "namespace": {
              "const": "agent-assure-governance-v1"
            },
            "signer_person_id": {
              "const": "acblabs"
            },
            "key_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "signature": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          }
        }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "base_commit",
            "allowed_paths",
            "work_limits",
            "out"
