            "action": {
              "const": "kickoff-plan"
            },
            "base_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "maxLength": 40
            },
            "allowed_paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "work_limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maximum_changed_files",
                "maximum_diff_lines",
                "maximum_wall_clock_seconds"
              ],
              "properties": {
                "maximum_changed_files": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                },
                "maximum_diff_lines": {
                  "type": "integer",
                  "minimum": 1
                },
                "maximum_wall_clock_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "out": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action",
            "claim",
            "signature_envelope",
            "out"
          ],
          "properties": {
            "action": {
              "const": "kickoff-import"
            },
            "claim": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "signature_envelope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "out": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
