{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acblabs.github.io/agent-assure/governance/v1/governance-bundle.schema.json",
  "title": "Agent Assure S1 corrective governed-baseline release object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "spec_revision",
    "acceptance_generation",
    "bundle_status",
    "sprint",
    "release",
    "train",
    "maturity",
    "artifact_kind",
    "source_ticket_ids",
    "authorization_effect",
    "installability",
    "distribution_channels",
    "package_version",
    "result_commit",
    "predecessor_acceptance",
    "corrective_authorization_claim_digest",
    "corrective_authorization",
    "roadmap_digest",
    "approval_roster_digest",
    "signed_decisions",
    "planning_evidence",
    "change_control",
    "post_result_verification",
    "artifact_inventory",
    "artifact_set_digest",
    "expected_closure",
    "compatibility_note",
    "known_limitations",
    "issuer_person_id",
    "issuer_role",
    "approval_mode",
    "independence_claimed",
    "time_evidence",
    "issued_at_utc",
    "valid_until_utc",
    "claim_prepared_at_utc",
    "bundle_digest",
    "signature_envelope",
    "signature_import_evidence"
  ],
  "properties": {
    "format": { "const": "agent-assure-governance-bundle/2" },
    "spec_revision": { "const": "6.5" },
    "acceptance_generation": { "const": 2 },
    "bundle_status": {
      "enum": ["pending_human_acceptance", "accepted_for_development"]
    },
    "sprint": { "const": "S1" },
    "release": { "const": "1.0.0a1" },
    "train": { "const": "stable-1.0" },
    "maturity": { "const": "governed-baseline-corrective-generation-2" },
    "artifact_kind": { "const": "governance-bundle" },
    "source_ticket_ids": { "const": ["V1-BOOT-01", "V1-BASE-01"] },
    "authorization_effect": { "const": "none" },
    "installability": { "const": "none" },
    "distribution_channels": { "const": [] },
    "package_version": { "type": "null" },
    "result_commit": { "$ref": "#/$defs/gitCommit" },
    "predecessor_acceptance": { "$ref": "#/$defs/predecessorAcceptance" },
    "corrective_authorization_claim_digest": {
      "const": "sha256:4477162d48826c8cece417e78ef8dcb4a5ef3047c24bf0cdef20d8fb55ba1f60"
    },
    "corrective_authorization": { "$ref": "#/$defs/correctiveAuthorization" },
    "roadmap_digest": { "$ref": "#/$defs/digest" },
    "approval_roster_digest": { "$ref": "#/$defs/digest" },
    "signed_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roster_selection_status", "ticket_completion_receipts"],
      "properties": {
        "roster_selection_status": { "enum": ["not_approved", "approved"] },
        "ticket_completion_receipts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/completionBinding" },
                {
                  "properties": {
                    "ticket_id": { "const": "V1-BASE-01" },
                    "superseded_receipt_digest": {
                      "const": "sha256:3a0a1a36586023147ea0e3cf7cf23d619bfc283da25445f5f72169eaf5226d1e"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/completionBinding" },
                {
                  "properties": {
                    "ticket_id": { "const": "V1-BOOT-01" },
                    "superseded_receipt_digest": {
                      "const": "sha256:ae5bf055cdd56292dec33422877a1fddce4a297b34879e5d58441ff8fa63c32a"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "planning_evidence": { "$ref": "#/$defs/planningEvidence" },
    "change_control": { "$ref": "#/$defs/changeControl" },
    "post_result_verification": { "$ref": "#/$defs/postR2Evidence" },
    "artifact_inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "path": {
                  "const": "docs/governance/v1/completion-receipt-v1-base-01.json"
                },
                "kind": { "const": "completion_receipt" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "properties": {
                "path": {
                  "const": "docs/governance/v1/completion-receipt-v1-boot-01.json"
                },
                "kind": { "const": "completion_receipt" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "artifact_set_digest": { "$ref": "#/$defs/digest" },
    "expected_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_parent_commit",
        "result_commit",
        "closure_parent_commit",
        "closure_changed_paths",
        "closure_change_statuses",
        "successor_acceptance_generation",
        "successor_tag_name"
      ],
      "properties": {
        "result_parent_commit": { "const": "6165bc6436aada6cbeb4fc4119eafa9b5dfdb000" },
        "result_commit": { "$ref": "#/$defs/gitCommit" },
        "closure_parent_commit": { "$ref": "#/$defs/gitCommit" },
        "closure_changed_paths": {
          "const": [
            "docs/governance/v1/completion-receipt-v1-base-01.json",
            "docs/governance/v1/completion-receipt-v1-boot-01.json",
            "docs/governance/v1/governance-bundle.json"
          ]
        },
        "closure_change_statuses": { "const": ["A", "M"] },
        "successor_acceptance_generation": { "const": 2 },
        "successor_tag_name": { "const": "agent-assure-s1-1.0.0a1-acceptance-v2" }
      }
    },
    "compatibility_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_package_version",
        "baseline_writer_schema_version",
        "production_behavior_changed",
        "installable_artifact_emitted",
        "note"
      ],
      "properties": {
        "baseline_package_version": { "const": "0.7.0" },
        "baseline_writer_schema_version": { "const": "0.6.6" },
        "production_behavior_changed": { "const": false },
        "installable_artifact_emitted": { "const": false },
        "note": {
          "const": "Generation 2 replaces only S1 planning-governance acceptance; package and writer identities remain unchanged."
        }
      }
    },
    "known_limitations": {
      "const": [
        "NO_INDEPENDENT_REVIEW",
        "SSHSIG contains no signing timestamp; no actual signing time is claimed.",
        "No method, profile, qualification, release, deployment, or runtime authorization is granted."
      ]
    },
    "issuer_person_id": { "$ref": "#/$defs/id" },
    "issuer_role": { "const": "repository_maintainer" },
    "approval_mode": { "const": "maintainer_development" },
    "independence_claimed": { "const": false },
    "time_evidence": { "$ref": "#/$defs/timeEvidence" },
    "issued_at_utc": { "$ref": "#/$defs/utc" },
    "valid_until_utc": { "$ref": "#/$defs/utc" },
    "claim_prepared_at_utc": { "$ref": "#/$defs/utc" },
    "bundle_digest": { "$ref": "#/$defs/digest" },
    "signature_envelope": { "$ref": "#/$defs/signature" },
    "signature_import_evidence": { "$ref": "#/$defs/signatureImportEvidence" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "bundle_status": { "const": "accepted_for_development" } },
        "required": ["bundle_status"]
      },
      "then": {
        "properties": {
          "signed_decisions": {
            "properties": {
              "roster_selection_status": { "const": "approved" },
              "ticket_completion_receipts": {
                "prefixItems": [
                  { "properties": { "receipt_status": { "const": "accepted_for_development" } } },
                  { "properties": { "receipt_status": { "const": "accepted_for_development" } } }
                ]
              }
            }
          },
          "signature_envelope": {
            "properties": { "status": { "const": "signed" } }
          },
          "signature_import_evidence": {
            "properties": { "status": { "const": "verified_after_import" } }
          }
        }
      },
      "else": {
        "properties": {
          "signature_envelope": {
            "properties": { "status": { "const": "pending_human_signature" } }
          },
          "signature_import_evidence": {
            "properties": { "status": { "const": "pending_signature_import" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size_bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": { "$ref": "#/$defs/id" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "changeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "change_status", "size_bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": { "$ref": "#/$defs/id" },
        "change_status": { "enum": ["A", "M"] },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "predecessorAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_generation",
        "disposition",
        "noncurrent_reason",
        "tag_name",
        "tag_object",
        "baseline_commit",
        "result_commit",
        "closure_commit",
        "bundle_digest",
        "forecast_digest",
        "objects_remain_immutable"
      ],
      "properties": {
        "acceptance_generation": { "const": 1 },
        "disposition": { "const": "superseded_nonconforming" },
        "noncurrent_reason": { "const": "forecast_and_governance_provenance_nonconformance" },
        "tag_name": { "const": "agent-assure-s1-1.0.0a1-acceptance" },
        "tag_object": { "const": "1f7bfe058dfb84d8cf4afaf971a57e5c3a12a5fb" },
        "baseline_commit": { "const": "3b060f4da94f4d0d80e7ae507580fce82ef9bf96" },
        "result_commit": { "const": "038b1a8c80fc419106eecd43f4a70b14ba026106" },
        "closure_commit": { "const": "6165bc6436aada6cbeb4fc4119eafa9b5dfdb000" },
        "bundle_digest": { "const": "sha256:62d4ddd81f2f619597b40a39d75a084e5bd0bc5ad99e2653f3fe6659b0194a82" },
        "forecast_digest": { "const": "sha256:e151679546b1a2d9f62a179052c97ba61ed6b249b05d69c11f23220287b56460" },
        "objects_remain_immutable": { "const": true }
      }
    },
    "correctiveAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_digest",
        "authorization_status",
        "authorization_kind",
        "authorization_effect",
        "authorized_person_id",
        "authorized_role"
      ],
      "properties": {
        "claim_digest": {
          "const": "sha256:4477162d48826c8cece417e78ef8dcb4a5ef3047c24bf0cdef20d8fb55ba1f60"
        },
        "authorization_status": { "const": "authorized" },
        "authorization_kind": { "const": "prospective_corrective_implementation" },
        "authorization_effect": { "const": "corrective_s1_development_governance_only" },
        "authorized_person_id": { "$ref": "#/$defs/id" },
        "authorized_role": { "const": "repository_maintainer" }
      }
    },
    "completionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket_id", "receipt_format", "receipt_status", "receipt_digest", "superseded_receipt_digest"],
      "properties": {
        "ticket_id": { "enum": ["V1-BASE-01", "V1-BOOT-01"] },
        "receipt_format": { "const": "agent-assure-ticket-completion-receipt/2" },
        "receipt_status": {
          "enum": ["pending_human_acceptance", "accepted_for_development"]
        },
        "receipt_digest": { "$ref": "#/$defs/digest" },
        "superseded_receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "planningEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_observations_digest",
        "forecast_format",
        "forecast_status",
        "human_review_status",
        "forecast_record_digest",
        "estimation_catalog_digest",
        "aggregation_method_registry_digest",
        "authoring_ledger_digest",
        "forecast_acceptance_status",
        "forecast_acceptance_receipt_digest"
      ],
      "properties": {
        "baseline_observations_digest": { "$ref": "#/$defs/digest" },
        "forecast_format": { "const": "agent-assure-delivery-forecast/2" },
        "forecast_status": { "$ref": "#/$defs/id" },
        "human_review_status": { "$ref": "#/$defs/id" },
        "forecast_record_digest": { "$ref": "#/$defs/digest" },
        "estimation_catalog_digest": { "$ref": "#/$defs/digest" },
        "aggregation_method_registry_digest": { "$ref": "#/$defs/digest" },
        "authoring_ledger_digest": { "$ref": "#/$defs/digest" },
        "forecast_acceptance_status": { "$ref": "#/$defs/id" },
        "forecast_acceptance_receipt_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "changeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_parent_commit",
        "result_commit",
        "authorized_change_paths",
        "authorized_change_paths_digest",
        "result_artifact_inventory",
        "result_artifact_set_digest"
      ],
      "properties": {
        "result_parent_commit": { "const": "6165bc6436aada6cbeb4fc4119eafa9b5dfdb000" },
        "result_commit": { "$ref": "#/$defs/gitCommit" },
        "authorized_change_paths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "authorized_change_paths_digest": { "$ref": "#/$defs/digest" },
        "result_artifact_inventory": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/changeArtifact" }
        },
        "result_artifact_set_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "timeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_basis", "sshsig_timestamp_capability", "actual_signature_time_claimed"],
      "properties": {
        "clock_basis": { "const": "maintainer_host_utc_externally_unattested" },
        "sshsig_timestamp_capability": { "const": "none" },
        "actual_signature_time_claimed": { "const": false }
      }
    },
    "repositoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_commit", "clean", "status_command", "status_stdout_size_bytes", "status_stdout_sha256"],
      "properties": {
        "head_commit": { "$ref": "#/$defs/gitCommit" },
        "clean": { "const": true },
        "status_command": { "const": ["git", "status", "--porcelain=v1", "--untracked-files=all"] },
        "status_stdout_size_bytes": { "const": 0 },
        "status_stdout_sha256": { "const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }
      }
    },
    "streamEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "size_bytes", "sha256"],
      "properties": {
        "file_name": { "enum": ["pytest.stdout.bin", "pytest.stderr.bin"] },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 268435456 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "postR2Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "acceptance_generation",
        "subject_result_parent_commit",
        "subject_result_commit",
        "corrective_authorization_claim_digest",
        "governance_sources",
        "repository_test_surface",
        "command",
        "time_evidence",
        "repository_precondition",
        "repository_postcondition",
        "execution",
        "evidence_digest"
      ],
      "properties": {
        "format": { "const": "agent-assure-s1-post-r2-suite-evidence/3" },
        "acceptance_generation": { "const": 2 },
        "subject_result_parent_commit": { "const": "6165bc6436aada6cbeb4fc4119eafa9b5dfdb000" },
        "subject_result_commit": { "$ref": "#/$defs/gitCommit" },
        "corrective_authorization_claim_digest": { "const": "sha256:4477162d48826c8cece417e78ef8dcb4a5ef3047c24bf0cdef20d8fb55ba1f60" },
        "governance_sources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size_bytes", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "size_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
              "sha256": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "repository_test_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "subject_result_commit", "directory_roots", "tracked_root_files", "root_config_paths", "cache_policy", "local_exclude", "file_count", "size_bytes", "sha256"],
          "properties": {
            "format": { "const": "agent-assure-s1-post-r2-test-surface/1" },
            "subject_result_commit": { "$ref": "#/$defs/gitCommit" },
            "directory_roots": { "const": [".githooks", ".github", "compat", "docs", "evidence", "examples", "mappings", "paper", "schemas", "scripts", "src", "tests", "third_party"] },
            "tracked_root_files": { "const": [".dockerignore", ".gitattributes", ".gitignore", ".gitleaks.toml", ".gitleaksignore", "CHANGELOG.md", "CITATION.cff", "CODE_OF_CONDUCT.md", "CONTRIBUTING.md", "FEATURES.md", "LICENSE", "Makefile", "README.md", "SECURITY.md", "THIRD_PARTY_NOTICES.md", "mkdocs.yml", "pyproject.toml", "requirements-adk.lock", "requirements-langgraph.lock", "requirements-min.constraints.txt", "requirements-min.lock", "requirements-otel.lock", "requirements.lock"] },
            "root_config_paths": { "const": [".coveragerc", "conftest.py", "mkdocs.yml", "pyproject.toml", "pytest.ini", "pytest.toml", "setup.cfg", "sitecustomize.py", "tox.ini", "usercustomize.py"] },
            "cache_policy": { "const": { "excluded_directory_name": "__pycache__", "reason": "fresh_absolute_pycache_prefix_makes_source_adjacent_caches_inert", "forbidden_direct_file_suffixes": [".pyc", ".pyo"] } },
            "local_exclude": { "const": { "path": ".git/info/exclude", "size_bytes": 2368, "sha256": "sha256:7c13bf60842aceead989daabbab30e5ae8fc3e4cf2100af9781e692790265060" } },
            "file_count": { "type": "integer", "minimum": 1 },
            "size_bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/digest" }
          }
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "working_directory", "environment", "python_executable", "descendant_runtime", "bootstrap_input", "bytecode_policy", "test_runtime"],
          "properties": {
            "argv": { "type": "array", "minItems": 29, "maxItems": 29, "items": { "type": "string", "minLength": 1, "maxLength": 65536 } },
            "working_directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "required": ["COMSPEC", "GIT_CONFIG_COUNT", "GIT_CONFIG_GLOBAL", "GIT_CONFIG_KEY_0", "GIT_CONFIG_KEY_1", "GIT_CONFIG_NOSYSTEM", "GIT_CONFIG_VALUE_0", "GIT_CONFIG_VALUE_1", "GIT_TERMINAL_PROMPT", "HOME", "HOMEDRIVE", "HOMEPATH", "HYPOTHESIS_STORAGE_DIRECTORY", "NO_COLOR", "NoDefaultCurrentDirectoryInExePath", "PATH", "PATHEXT", "PROCESSOR_ARCHITECTURE", "PYTHONNOUSERSITE", "PYTHONPYCACHEPREFIX", "PYTHONSAFEPATH", "PYTHONDONTWRITEBYTECODE", "PYTHONUTF8", "PY_COLORS", "PYTEST_DISABLE_PLUGIN_AUTOLOAD", "SYSTEMROOT", "TEMP", "TMP", "USERPROFILE", "WINDIR"],
              "properties": {
                "COMSPEC": { "const": "C:\\Windows\\System32\\cmd.exe" },
                "GIT_CONFIG_COUNT": { "const": "2" },
                "GIT_CONFIG_GLOBAL": { "const": "NUL" },
                "GIT_CONFIG_KEY_0": { "const": "core.autocrlf" },
                "GIT_CONFIG_KEY_1": { "const": "safe.directory" },
                "GIT_CONFIG_NOSYSTEM": { "const": "1" },
                "GIT_CONFIG_VALUE_0": { "const": "true" },
                "GIT_CONFIG_VALUE_1": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "GIT_TERMINAL_PROMPT": { "const": "0" },
                "HOME": { "const": "C:\\Users\\user" },
                "HOMEDRIVE": { "const": "C:" },
                "HOMEPATH": { "const": "\\Users\\user" },
                "HYPOTHESIS_STORAGE_DIRECTORY": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "NO_COLOR": { "const": "1" },
                "NoDefaultCurrentDirectoryInExePath": { "const": "1" },
                "PATH": { "type": "string", "minLength": 1, "maxLength": 32768 },
                "PATHEXT": { "const": ".COM;.EXE;.BAT;.CMD" },
                "PROCESSOR_ARCHITECTURE": { "const": "AMD64" },
                "PYTHONNOUSERSITE": { "const": "1" },
                "PYTHONPYCACHEPREFIX": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "PYTHONSAFEPATH": { "const": "1" },
                "PYTHONDONTWRITEBYTECODE": { "const": "1" },
                "PYTHONUTF8": { "const": "1" },
                "PY_COLORS": { "const": "0" },
                "PYTEST_DISABLE_PLUGIN_AUTOLOAD": { "const": "1" },
                "SYSTEMROOT": { "const": "C:\\Windows" },
