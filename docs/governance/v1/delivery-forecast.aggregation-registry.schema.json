{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acblabs.github.io/agent-assure/governance/v1/delivery-forecast.aggregation-registry.schema.json",
  "title": "Agent Assure delivery forecast aggregation-method registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "spec_revision", "registry_digest_domain", "methods", "registry_digest"],
  "properties": {
    "format": { "const": "agent-assure-delivery-forecast-aggregation-registry/2" },
    "spec_revision": { "const": "6.5" },
    "registry_digest_domain": { "const": "agent-assure:delivery-forecast-aggregation-registry/v2" },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/method" }
    },
    "registry_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "sumRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "source_field", "quantile_rank"],
      "properties": {
        "operation": { "const": "checked_integer_sum" },
        "source_field": { "$ref": "#/$defs/nonempty" },
        "quantile_rank": { "enum": [0.5, 0.9] }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "method_id",
        "version",
        "definition_digest_domain",
        "unit",
        "evaluated_quantile_ranks",
        "quantile_definition",
        "effort_scope",
        "dependence_model",
        "aggregation",
        "scenario_aggregation",
        "interpretation",
        "arithmetic",
        "definition_digest"
      ],
      "properties": {
        "format": { "const": "agent-assure-delivery-forecast-aggregation-method/2" },
        "method_id": { "const": "comonotonic-quantile-sum/v1" },
        "version": { "const": "1.1.0" },
        "definition_digest_domain": { "const": "agent-assure:delivery-forecast-aggregation-method/v2" },
        "unit": { "const": "focused_person_hour" },
        "evaluated_quantile_ranks": { "const": [0.5, 0.9] },
        "quantile_definition": { "$ref": "#/$defs/nonempty" },
        "effort_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": { "$ref": "#/$defs/stringSet" },
            "excluded": { "$ref": "#/$defs/stringSet" }
          }
        },
        "dependence_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "definition",
            "independence_claimed",
            "upper_bound_claimed",
            "diversification_credit",
            "reviewer_effort_coupling"
          ],
          "properties": {
            "name": { "const": "full_positive_rank_dependence_no_diversification_credit" },
            "definition": { "$ref": "#/$defs/nonempty" },
            "independence_claimed": { "const": false },
            "upper_bound_claimed": { "const": false },
            "diversification_credit": { "const": "none" },
            "reviewer_effort_coupling": { "$ref": "#/$defs/nonempty" }
          }
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregate_p50_effort_hours",
            "aggregate_p90_effort_hours",
            "aggregate_reviewer_effort_hours"
          ],
          "properties": {
            "aggregate_p50_effort_hours": { "$ref": "#/$defs/sumRule" },
            "aggregate_p90_effort_hours": { "$ref": "#/$defs/sumRule" },
            "aggregate_reviewer_effort_hours": { "$ref": "#/$defs/sumRule" }
          }
        },
        "scenario_aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["partition_field", "required_partitions", "full_portfolio_operation"],
          "properties": {
            "partition_field": { "const": "scenario_class" },
            "required_partitions": { "const": ["stable_core_committed", "optional_profile_planned"] },
            "full_portfolio_operation": { "const": "checked_effort_and_occurrence_sum_with_ticket_id_union" }
          }
        },
        "interpretation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "arithmetic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_type", "maximum_exact_integer", "rounding"],
          "properties": {
            "input_type": { "const": "nonnegative integer hours" },
            "maximum_exact_integer": { "const": 9007199254740991 },
            "rounding": { "$ref": "#/$defs/nonempty" }
          }
        },
        "definition_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
