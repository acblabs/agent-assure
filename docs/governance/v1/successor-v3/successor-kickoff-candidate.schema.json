{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-assure.invalid/governance/v3r2/successor-kickoff-candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "digest_domain",
    "package_id",
    "authorization_id",
    "state",
    "authorization_effect",
    "claim",
    "source_state_digest",
    "protocol_bundle_digest",
    "candidate_digest"
  ],
  "properties": {
    "format": {
      "const": "agent-assure-s1-successor-kickoff-candidate/2"
    },
    "digest_domain": {
      "const": "agent-assure:s1-successor-kickoff-candidate/v2"
    },
    "package_id": {
      "const": "18dd650c-86ac-4f35-b7e0-7719fad06a7f"
    },
    "authorization_id": {
      "const": "5245b185-917d-4338-bcc2-677a68ad2bbd"
    },
    "state": {
      "const": "unsigned_candidate"
    },
    "authorization_effect": {
      "const": "none"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "raw_sha256",
        "semantic_digest",
        "schema_path"
      ],
      "properties": {
        "path": {
          "const": "claims/kickoff.claim"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_path": {
          "const": "successor-kickoff-claim.schema.json"
        }
      }
    },
    "source_state_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "protocol_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
