{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-assure.invalid/governance/v3r2/check-contracts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "digest_domain",
    "package_id",
    "tooling",
    "hosted_ci",
    "preclosure_graph",
    "full_ceremony_graph",
    "check_contracts_digest"
  ],
  "properties": {
    "format": {
      "const": "agent-assure-s1-successor-check-contracts/2"
    },
    "digest_domain": {
      "const": "agent-assure:s1-successor-check-contract-set/v2"
    },
    "package_id": {
      "const": "a974a9e0-c780-4288-9238-21144a4a5b8d"
    },
    "tooling": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "role",
          "runtime",
          "private_key_access"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "runtime_launcher",
              "package_builder",
              "validator_importer"
            ]
          },
          "runtime": {
            "enum": [
              "exact_Windows_PowerShell_5.1_launcher_authenticating_base_runtime",
              "exact_frozen_CPython_3.12.13_with_authenticated_dependencies;source_syntax_CPython_3.11"
            ]
          },
          "private_key_access": {
            "const": false
          }
        }
      }
    },
    "hosted_ci": {
      "const": {
        "provider": "github_actions",
        "repository": "acblabs/agent-assure",
        "workflow_path": ".github/workflows/ci.yml",
        "workflow_name": "ci",
        "event": "push",
        "head_branch": "fix/s1-governed-baseline-v3",
        "job_instance_count": 21,
        "job_names": [
          "test (3.11)",
          "test (3.12)",
          "test (3.13)",
          "test (3.14)",
          "dependency lower bounds / Python 3.11",
          "dependency lower bounds / Python 3.14",
          "composite-action-smoke",
          "composite-action-strict-smoke",
          "coverage / unit-a",
          "coverage / unit-b1",
          "coverage / unit-b2",
          "coverage / unit-top",
          "coverage / integration",
          "coverage-gate",
          "windows-containment (3.11)",
          "windows-containment (3.14)",
          "schema-immutability",
          "Windows governance / Python 3.12",
          "langgraph-smoke",
          "adk-smoke",
          "otel-contract"
        ],
        "matrix": {
          "test": {
            "runs_on": "ubuntu-24.04",
            "python_versions": [
              "3.11",
              "3.12",
              "3.13",
              "3.14"
            ]
          },
          "dependency_lower_bounds": {
            "runs_on": "ubuntu-24.04",
            "python_versions": [
              "3.11",
              "3.14"
            ]
          },
          "coverage": {
            "runs_on": "ubuntu-24.04",
            "shards": [
              {
                "name": "unit-a",
                "test_paths": "tests/unit/adapters tests/unit/authoring tests/unit/canonical tests/unit/compare tests/unit/controls tests/unit/demo tests/unit/docs tests/unit/evaluation tests/unit/examples tests/unit/fixtures tests/unit/governance tests/unit/graph tests/unit/mutation"
              },
              {
                "name": "unit-b1",
                "test_paths": "tests/unit/policies tests/unit/privacy tests/unit/rag tests/unit/release tests/unit/reporting"
              },
              {
                "name": "unit-b2",
                "test_paths": "tests/unit/runner tests/unit/schema tests/unit/statistics tests/unit/streaming tests/unit/study tests/unit/telemetry tests/unit/usage"
              },
              {
                "name": "unit-top",
                "test_paths": "tests/unit/test_*.py"
              },
              {
                "name": "integration",
                "test_paths": "tests/integration"
              }
            ]
          },
          "windows_containment": {
            "runs_on": "windows-2025",
            "python_versions": [
              "3.11",
              "3.14"
            ]
          },
          "singleton_job_ids": [
            "composite-action-smoke",
            "composite-action-strict-smoke",
            "coverage-gate",
            "schema-immutability",
            "windows-governance",
            "langgraph-smoke",
            "adk-smoke",
            "otel-contract"
          ]
        },
        "api": {
          "version": "2022-11-28",
          "jobs_filter": "latest",
          "per_page": 100,
          "require_total_count_equals_returned": true,
          "require_completed_success": true
        }
      }
    },
    "preclosure_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_domain",
        "nodes",
        "edges",
        "terminal_node",
        "max_combined_output_bytes",
        "max_combined_semantic_output_bytes",
        "graph_digest"
      ],
      "properties": {
        "digest_domain": {
          "const": "agent-assure:s1-successor-preclosure-check-graph/v2"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "phase",
              "kind",
              "predicate",
              "subject_role",
              "producer",
              "commands",
              "max_combined_output_bytes",
              "max_semantic_output_bytes",
              "success"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^g3\\."
              },
              "phase": {
                "enum": [
                  "preclosure",
                  "postclosure"
                ]
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "const": 1
                  }
                }
              },
              "subject_role": {
                "enum": [
                  "C1",
                  "C2",
                  "B3",
                  "K3",
                  "R3",
                  "C3",
                  "A3",
                  "CEREMONY"
                ]
              },
              "producer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "runtime_role",
                  "identity_binding"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "runtime_role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "identity_binding": {
                    "enum": [
                      "exact_binary_and_dependency_inventory",
                      "tracked_workflow_and_remote_API_evidence",
                      "pure_deterministic_aggregation"
                    ]
                  }
                }
              },
              "commands": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "executable_role",
                    "argv",
                    "cwd",
                    "environment",
                    "timeout_seconds",
                    "max_output_bytes"
                  ],
                  "properties": {
                    "executable_role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "argv": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "cwd": {
                      "enum": [
                        "{isolated_repository_root}",
                        "{TEMP}"
                      ]
                    },
                    "environment": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "inherit",
                        "fixed",
                        "fresh_paths",
                        "secret_inputs"
                      ],
                      "properties": {
                        "inherit": {
                          "const": false
                        },
                        "fixed": {
                          "type": "object",
                          "maxProperties": 24,
                          "propertyNames": {
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "fresh_paths": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "uniqueItems": true
                        },
                        "secret_inputs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Z][A-Z0-9_]*$"
                          },
                          "uniqueItems": true
                        }
                      }
                    },
                    "timeout_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 14400
                    },
                    "max_output_bytes": {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 16777216
                    }
                  }
                }
              },
              "max_combined_output_bytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 100663296
              },
              "max_semantic_output_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "success": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exit_codes",
                  "forbidden_statuses",
                  "requirements"
                ],
                "properties": {
                  "exit_codes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "const": 0
                    }
                  },
                  "forbidden_statuses": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "prefixItems": [
                      {
                        "const": "deselected"
                      },
                      {
                        "const": "not_evaluated"
                      },
                      {
                        "const": "skip"
                      },
                      {
                        "const": "waive"
                      }
                    ],
                    "items": false
                  },
                  "requirements": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          }
        },
        "terminal_node": {
          "type": "string"
        },
        "max_combined_output_bytes": {
          "enum": [
            33554432,
            41943040
          ]
        },
        "max_combined_semantic_output_bytes": {
          "enum": [
            50331648,
            67108864
          ]
        },
        "graph_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
