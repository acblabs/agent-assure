        "actual_signature_time_claimed": { "const": false },
        "verification_result": {
          "enum": [null, "valid_exact_payload_key_and_namespace"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "verified_after_import" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "verification_recorded_at_utc": { "$ref": "#/$defs/utc" },
              "verification_result": { "const": "valid_exact_payload_key_and_namespace" }
            }
          },
          "else": {
            "properties": {
              "verification_recorded_at_utc": { "type": "null" },
              "verification_result": { "type": "null" }
            }
          }
        }
      ]
    }
