                "descendant_write_policy": { "const": "explicit_-B_injected_at_recursive_Popen_boundary" },
                "descendant_guard_bypass_policy": { "const": "sitecustomize_fails_closed_without_exact_cli_policy" },
                "pycache_prefix_postcondition": { "const": "absent_after_suite_execution" },
