        },
        "signature": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "maxLength": 8192
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "signed" } },
            "required": ["status"]
          },
          "then": { "properties": { "signature": { "type": "string", "minLength": 1 } } },
          "else": { "properties": { "signature": { "type": "null" } } }
        }
      ]
    },
    "signatureImportEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verification_recorded_at_utc",
        "clock_basis",
        "sshsig_timestamp_capability",
        "actual_signature_time_claimed",
        "verification_result"
