{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acblabs.github.io/agent-assure/governance/v1/ticket-completion-receipt.schema.json",
  "title": "Agent Assure S1 ticket completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "spec_revision",
    "receipt_purpose",
    "receipt_status",
    "subject_ticket_id",
    "subject_dispatch_kind",
    "subject_stage",
    "subject_roadmap_digest",
    "subject_report",
    "reviewed_artifacts",
    "reviewed_artifact_set_digest",
    "approval_roster_digest",
    "kickoff_authorization_digest",
    "base_commit",
    "result_commit",
    "issuer_person_id",
    "issuer_role",
    "owner_role",
    "approval_mode",
    "author_reviewer_relationship",
    "independence_claimed",
    "authorization_effect",
    "accepted_competence",
    "conflicts",
    "issued_at_utc",
    "valid_until_utc",
    "allowed_operations",
    "limitations",
    "receipt_digest",
    "signature_envelope"
  ],
  "properties": {
    "format": { "const": "agent-assure-ticket-completion-receipt/1" },
    "spec_revision": { "const": "6.5" },
    "receipt_purpose": { "const": "development_design_acceptance" },
    "receipt_status": {
      "enum": ["pending_human_acceptance", "accepted_for_development"]
    },
    "subject_ticket_id": { "enum": ["V1-BOOT-01", "V1-BASE-01"] },
    "subject_dispatch_kind": { "enum": ["kickoff", "inventory"] },
    "subject_stage": { "const": "S1-governed-baseline" },
    "subject_roadmap_digest": { "$ref": "#/$defs/digest" },
    "subject_report": { "$ref": "#/$defs/artifact" },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "reviewed_artifact_set_digest": { "$ref": "#/$defs/digest" },
    "approval_roster_digest": { "$ref": "#/$defs/digest" },
    "kickoff_authorization_digest": { "$ref": "#/$defs/digest" },
    "base_commit": { "$ref": "#/$defs/gitCommit" },
    "result_commit": {
      "oneOf": [{ "$ref": "#/$defs/gitCommit" }, { "type": "null" }]
    },
    "issuer_person_id": { "$ref": "#/$defs/id" },
    "issuer_role": { "const": "repository_maintainer" },
    "owner_role": { "const": "technical_lead" },
    "approval_mode": { "const": "maintainer_development" },
    "author_reviewer_relationship": {
      "const": "same_person_maintainer_development_self_acceptance"
    },
    "independence_claimed": { "const": false },
    "authorization_effect": { "const": "none" },
    "accepted_competence": { "$ref": "#/$defs/stringSet" },
    "conflicts": { "$ref": "#/$defs/stringSet" },
    "issued_at_utc": { "$ref": "#/$defs/utc" },
    "valid_until_utc": { "$ref": "#/$defs/utc" },
    "allowed_operations": { "$ref": "#/$defs/stringSet" },
    "limitations": { "$ref": "#/$defs/stringSet" },
    "receipt_digest": { "$ref": "#/$defs/digest" },
    "signature_envelope": { "$ref": "#/$defs/signature" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "receipt_status": { "const": "accepted_for_development" } },
        "required": ["receipt_status"]
      },
      "then": { "properties": { "result_commit": { "$ref": "#/$defs/gitCommit" } } },
      "else": { "properties": { "result_commit": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "receipt_status": { "const": "accepted_for_development" } },
        "required": ["receipt_status"]
      },
      "then": {
        "properties": {
          "signature_envelope": {
            "properties": { "status": { "const": "signed" } }
          }
        }
      },
      "else": {
        "properties": {
          "signature_envelope": {
            "properties": { "status": { "const": "pending_human_signature" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonempty" }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "kind": { "$ref": "#/$defs/id" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "status",
        "namespace",
        "signed_payload_encoding",
        "signature_encoding",
        "signer_person_id",
        "signer_role",
        "subject_digest",
        "public_key_fingerprint",
        "signed_at_utc",
        "signature"
      ],
      "properties": {
        "profile": { "const": "openssh-sshsig-ed25519/v1" },
        "status": { "enum": ["pending_human_signature", "signed"] },
        "namespace": { "const": "agent-assure-governance-v1" },
        "signed_payload_encoding": {
          "const": "agent-assure-domain-separated-rfc8785-signature-claim/v1"
        },
        "signature_encoding": {
          "const": "base64-canonical-lf-openssh-sshsig-armored"
        },
        "signer_person_id": { "$ref": "#/$defs/id" },
        "signer_role": { "$ref": "#/$defs/id" },
        "subject_digest": { "$ref": "#/$defs/digest" },
        "public_key_fingerprint": {
          "const": "SHA256:L/6IRITdktnUQOfbr6iuf48k2MtolzDFvxWaQHU4G7k"
        },
        "signed_at_utc": {
          "oneOf": [{ "$ref": "#/$defs/utc" }, { "type": "null" }]
        },
        "signature": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "maxLength": 8192
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "signed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "signed_at_utc": { "$ref": "#/$defs/utc" },
              "signature": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "properties": {
              "signed_at_utc": { "type": "null" },
              "signature": { "type": "null" }
            }
          }
        }
      ]
    }
  }
}
